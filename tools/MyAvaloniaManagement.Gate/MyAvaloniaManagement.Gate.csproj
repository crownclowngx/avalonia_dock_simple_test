<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>MyAvaloniaManagement.Gate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\build\RuntimeProfile.cs" Link="RuntimeProfile.cs" />
    <EmbeddedResource Include="..\..\build\MyAvaloniaManagement.RuntimeProfile.props" LogicalName="Compatibility.RuntimeProfile" />
    <None Include="gate.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
