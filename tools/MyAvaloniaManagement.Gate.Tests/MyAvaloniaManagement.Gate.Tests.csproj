<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MyAvaloniaManagement.Gate/MyAvaloniaManagement.Gate.csproj" />
    <!-- 验收入口的参数和进程边界不依赖 UI；源复用允许工具自测保持轻量。 -->
    <Compile Include="../MyAvaloniaManagement.Compatibility/CompatibilityOptions.cs" Link="CompatibilityOptions.cs" />
    <Compile Include="../MyAvaloniaManagement.Compatibility/CompatibilityProcess.cs" Link="CompatibilityProcess.cs" />
  </ItemGroup>
</Project>
