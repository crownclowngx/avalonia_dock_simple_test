<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>MyAvaloniaManagement.Plugin.Templates</PackageId>
    <Version>1.0.1</Version>
    <PackageVersion>1.0.1</PackageVersion>
    <Title>MyAvaloniaManagement Managed Plugin Templates</Title>
    <Description>创建可独立预览、测试并打包给 MyAvaloniaManagement Host 加载的 Avalonia Managed Plugin。</Description>
    <Authors>MyAvaloniaManagement Contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://gitee.com/crownclowngx/avalonia_dock_simple_test.git</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/crownclowngx/avalonia_dock_simple_test</PackageProjectUrl>
    <PackageTags>dotnet-new;template;avalonia;plugin;managed-plugin</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsPackable>true</IsPackable>
    <!-- Template 包故意没有 lib/ref 程序集。 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="content\**\*.cs" />
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**"
             Pack="true"
             PackagePath="content" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
