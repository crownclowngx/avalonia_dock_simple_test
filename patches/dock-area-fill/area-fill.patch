+    private sealed class TabState(IDockManager manager) : DockControlState(manager, new DefaultDragOffsetCalculator())
+    {
+        public DockTarget? Target => LocalAdornerHelper.Adorner as DockTarget;
+        public bool HasTarget => DropControl is not null;
+        public int Executions { get; private set; }
+        public DockOperation? Executed { get; private set; }
+        protected override void Execute(Point p, DockOperation op, DragAction a, Visual v, IDockable source, IDockable target)
+        { Executions++; Executed = op; }
+    }
+
+    private sealed class WindowState(IDockManager manager, HostWindow window) : HostWindowState(manager, window)
+    {
+        public DockTarget? Target => LocalAdornerHelper.Adorner as DockTarget;
