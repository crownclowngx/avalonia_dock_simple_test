+
+namespace Dock.Avalonia.Contract;
+
+/// <summary>供拥有特殊布局规则的宿主只读调整预览范围，不参与命中或执行布局变更。</summary>
+public interface IDockPreviewProvider
+{
+    /// <summary>返回相对 dropControl 的预览矩形；null 表示使用框架默认预览。</summary>
+    Rect? GetPreviewBounds(IDockable source, IDockable target, DockOperation operation, Control dropControl);
+}
