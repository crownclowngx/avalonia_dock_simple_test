@@ -0,0 +1,13 @@
+using Dock.Model.Core;
+
+namespace Dock.Avalonia.Contract;
+
+/// <summary>
+/// 可由宿主 Factory 实现的附加拖放约束。框架继续负责类型和能力校验；
+/// 此接口只表达宿主运行状态（例如内容全屏）是否允许本次迁移。
+/// </summary>
+public interface IDockDropGuard
+{
+    /// <summary>只读判断，预览与提交均会调用；实现不得在此移动模型或保存布局。</summary>
+    bool CanDrop(IDockable source, IDockable target, DockOperation operation);
+}
