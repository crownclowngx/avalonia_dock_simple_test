+using System;
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Headless.XUnit;
+using Avalonia.Media;
+using Dock.Avalonia.Controls;
+using Dock.Avalonia.Contract;
+using Dock.Avalonia.Internal;
+using Dock.Model;
+using Dock.Model.Avalonia;
+using Dock.Model.Avalonia.Controls;
+using Dock.Model.Core;
+using Dock.Settings;
+using Xunit;
+
+namespace Dock.Avalonia.HeadlessTests;
+
+/// <summary>用独立坐标的局部和全局按钮验证统一决策，尤其是默认 Fill 不能吞掉全局按钮。</summary>
+public class DockAreaFillResolutionTests
+{
+    private sealed class LocalTarget : DockTarget
+    {
+        public Panel Indicator { get; } = new() { Width = 400, Height = 300 };
+        public void Register() { IndicatorOperations.Clear(); SelectorsOperations.Clear(); IndicatorOperations[DockOperation.Fill] = Indicator; }
+    }
+
+    private sealed class GlobalTarget : GlobalDockTarget
+    {
+        public Border Selector { get; } = new() { Width = 30, Height = 30, Background = Brushes.White };
+        public Panel Indicator { get; } = new();
+        public void Register()
+        {
+            IndicatorOperations.Clear(); SelectorsOperations.Clear();
+            IndicatorOperations[DockOperation.Top] = Indicator;
+            SelectorsOperations[DockOperation.Top] = Selector;
+        }
+    }
+
+    private sealed class PreviewFactory : Factory, IDockPreviewProvider
+    {
+        public Rect? GetPreviewBounds(IDockable source, IDockable target, DockOperation operation, Control dropControl)
+            => new Rect(-100, 20, 700, 80);
+    }
+
+    private sealed class State(LocalTarget local, GlobalTarget global) : DockManagerState(new DockManager(new DockService()))
+    {
+        public (DockOperation Operation, bool Valid, bool Global) Resolve(Control area, Point point, bool allowGlobal, IDockable? source)
+        {
+            LocalAdornerHelper.Adorner = local;
+            GlobalAdornerHelper.Adorner = global;
+            var result = ResolveOperation(point, DragAction.Move, area, area,
+                (_, _, _, _) => true, (_, _, _, _) => allowGlobal, (_, _, _, _) => true, source);
+            return (result.SelectedOperation, result.IsValid, result.UseGlobalOperation);
+        }
+    }
+
+    [AvaloniaTheory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public void 全局明确按钮优先于区域合并且被拒绝时没有局部高亮(bool allowed)
+    {
+        WithScene((local, global, area) =>
+        {
+            var result = new State(local, global).Resolve(area, new Point(15, 15), allowed, null);
+            Assert.True(result.Global);
+            Assert.Equal(allowed, result.Valid);
+            Assert.Equal(allowed ? DockOperation.Top : DockOperation.None, result.Operation);
+            Assert.Equal(0, local.Indicator.Opacity);
+            Assert.Equal(allowed ? 0.5 : 0, global.Indicator.Opacity);
+        });
+    }
+
+    [AvaloniaFact]
+    public void 宿主预览矩形只调整高亮且下一次计算恢复模板范围()
+    {
+        WithScene((local, global, area) =>
+        {
+            var state = new State(local, global);
+            var source = new Document { Factory = new PreviewFactory() };
+            var point = new Point(200, 180);
+            var result = state.Resolve(area, point, true, source);
+            Assert.True(result.Valid);
+            Assert.Equal(DockOperation.Fill, result.Operation);
+            var transform = Assert.IsType<MatrixTransform>(local.Indicator.RenderTransform).Matrix;
+            Assert.Equal(new Point(-100, 20), transform.Transform(default));
+            Assert.Equal(new Point(600, 100), transform.Transform(new Point(400, 300)));
+            state.Resolve(area, point, true, null);
+            Assert.Null(local.Indicator.RenderTransform);
+            ((IDockTarget)local).Reset();
+            Assert.Equal(0, local.Indicator.Opacity);
+        });
+    }
+
+    private static void WithScene(Action<LocalTarget, GlobalTarget, Canvas> action)
+    {
+        var local = new LocalTarget { FillOnAreaDrop = true };
+        var global = new GlobalTarget();
+        var area = new Canvas { Width = 400, Height = 300, DataContext = new DocumentDock() };
+        DockProperties.SetIsDockTarget(area, true);
+        area.Children.Add(local); area.Children.Add(global); area.Children.Add(local.Indicator); area.Children.Add(global.Selector);
+        var window = new Window { Width = 400, Height = 300, Content = area };
+        window.Show();
+        try { window.UpdateLayout(); local.Register(); global.Register(); action(local, global, area); }
+        finally { window.Close(); }
+    }
+}
