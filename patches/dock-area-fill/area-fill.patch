+        Assert.False(state.HasTarget);
+        state.Process(point, default, EventType.Released, DragAction.Move, scene.SourceControl, controls);
+        Assert.Equal(expected, state.Executions);
+    }
+
+    [AvaloniaTheory]
+    [InlineData("fill", 1)]
+    [InlineData("outside", 0)]
+    [InlineData("guard", 0)]
+    [InlineData("cancel", 0)]
