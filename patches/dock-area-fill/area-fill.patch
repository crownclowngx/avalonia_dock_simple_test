+
+    [AvaloniaTheory]
+    [InlineData("fill", 1)]
+    [InlineData("outside", 0)]
+    [InlineData("guard", 0)]
+    [InlineData("cancel", 0)]
+    [InlineData("disabled", 0)]
+    [InlineData("closed", 0)]
+    [InlineData("capability", 0)]
+    public void 标签拖动使用最终坐标及权限且只提交一次(string ending, int expected)
+    {
+        using var scene = new Scene();
+        var state = new TabState(new DockManager(new DockService()));
+        var controls = new List<IDockControl> { scene.TargetControl, scene.SourceControl };
+        var point = scene.SourceControl.PointToClient(scene.Area.PointToScreen(new Point(100, 170)));
+        state.StartDrag(scene.Header, new Point(5, 5), new Point(5, 5), scene.SourceControl);
+        state.Process(point, default, EventType.Moved, DragAction.Move, scene.SourceControl, controls);
+        Assert.NotNull(state.Target);
+        state.Target!.FillOnAreaDrop = true;
+        scene.Main.UpdateLayout();
+        global::Avalonia.Headless.AvaloniaHeadlessPlatform.ForceRenderTimerTick();
+        state.Process(point, default, EventType.Moved, DragAction.Move, scene.SourceControl, controls);
+        Assert.Equal(0, state.Executions);
+        if (ending == "outside") point = new Point(-3000, -3000);
+        if (ending == "guard") scene.Factory.Allowed = false;
+        if (ending == "disabled") DockProperties.SetIsDropEnabled(scene.Area, false);
+        if (ending == "closed") scene.Main.Close();
+        if (ending == "capability") ((IDockable)scene.Area.DataContext!).CanDrop = false;
+        state.Process(point, default, ending == "cancel" ? EventType.CaptureLost : EventType.Released,
