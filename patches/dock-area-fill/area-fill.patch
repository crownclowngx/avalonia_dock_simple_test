+            global::Avalonia.Threading.Dispatcher.UIThread.RunJobs();
+            Main.UpdateLayout();
+            Floating.UpdateLayout();
+            global::Avalonia.Headless.AvaloniaHeadlessPlatform.ForceRenderTimerTick();
+            Assert.NotNull(SourceControl.GetVisualRoot());
+            Assert.NotNull(DockHelpers.GetControl(TargetControl, new Point(100, 170), DockProperties.IsDropAreaProperty));
+            // 纯代码模板不依赖样例应用的初始化器，显式登记参与本次拖放的两个表面。
+            if (!Factory.DockControls.Contains(TargetControl)) Factory.DockControls.Add(TargetControl);
+            if (!Factory.DockControls.Contains(SourceControl)) Factory.DockControls.Add(SourceControl);
+        }
+
+        public void Dispose() { Floating.Close(); Main.Close(); }
+    }
+}
