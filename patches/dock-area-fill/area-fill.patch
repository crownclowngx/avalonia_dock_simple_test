--- /dev/null
+++ b/tests/Dock.Avalonia.HeadlessTests/DockAreaFillTests.cs
@@ -0,0 +1,137 @@
+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Headless.XUnit;
+using Avalonia.Media;
+using Dock.Avalonia.Controls;
+using Dock.Model.Avalonia.Controls;
+using Dock.Model.Core;
+using Dock.Settings;
+using Xunit;
+
+namespace Dock.Avalonia.HeadlessTests;
+
+/// <summary>
+/// 从实际目标控件的命中入口验证区域停靠，避免仅调用 DockManager 掩盖鼠标命中问题。
+/// 使用小型测试布局固定坐标，方向按钮与内容区域分别拥有独立边界。
+/// </summary>
+public class DockAreaFillTests
+{
+    private sealed class Target : DockTarget
+    {
+        public Panel FillIndicator { get; } = new();
+        public Panel LeftIndicator { get; } = new();
+        public Border LeftSelector { get; } = new() { Background = Brushes.White, Width = 30, Height = 30 };
+
+        public void Register()
+        {
+            IndicatorOperations.Clear();
+            SelectorsOperations.Clear();
+            IndicatorOperations[DockOperation.Left] = LeftIndicator;
+            IndicatorOperations[DockOperation.Fill] = FillIndicator;
+            SelectorsOperations[DockOperation.Left] = LeftSelector;
+        }
+    }
+
+    [AvaloniaTheory]
+    [InlineData(true, 200, 180, DockOperation.Fill)]
+    [InlineData(false, 200, 180, DockOperation.Window)]
+    [InlineData(true, 450, 180, DockOperation.Window)]
+    [InlineData(true, -1, 180, DockOperation.Window)]
+    public void 区域回退仅作用于启用后的内容边界(bool enabled, double x, double y, DockOperation expected)
+    {
+        WithTarget((target, area) =>
+        {
+            target.FillOnAreaDrop = enabled;
+            var result = target.GetDockOperation(new Point(x, y), area, area, DragAction.Move, (_, _, _, _) => true);
+            Assert.Equal(expected, result);
+            Assert.Equal(expected == DockOperation.Fill ? 0.5 : 0, target.FillIndicator.Opacity);
+        });
+    }
+
+    [AvaloniaTheory]
+    [InlineData(true, DockOperation.Left)]
+    [InlineData(false, DockOperation.Window)]
+    public void 明确方向优先且拒绝后不偷偷合并(bool allowDirection, DockOperation expected)
+    {
+        WithTarget((target, area) =>
+        {
+            var result = target.GetDockOperation(new Point(15, 15), area, area, DragAction.Move,
+                (_, operation, _, _) => operation != DockOperation.Left || allowDirection);
+            Assert.Equal(expected, result);
+            Assert.Equal(0, target.FillIndicator.Opacity);
+        });
+    }
+
+    [AvaloniaTheory]
+    [InlineData(false, true)]
+    [InlineData(true, false)]
+    public void 居中必须同时通过可见性与能力校验(bool allowed, bool visible)
+    {
+        WithTarget((target, area) =>
+        {
+            Assert.Equal(DockOperation.Window, target.GetDockOperation(new Point(200, 180), area, area,
+                DragAction.Move, (_, _, _, _) => allowed, (_, _, _, _) => visible));
+            Assert.Equal(0, target.FillIndicator.Opacity);
+        });
+    }
+
+    [AvaloniaFact]
+    public void 非停靠分组及复用状态不会触发区域合并()
+    {
+        WithTarget((target, area) =>
+        {
+            area.DataContext = new RootDock();
+            Assert.Equal(DockOperation.Window, target.GetDockOperation(new Point(200, 180), area, area,
+                DragAction.Move, (_, _, _, _) => true));
+            area.DataContext = new DocumentDock();
+            Assert.Equal(DockOperation.Fill, target.GetDockOperation(new Point(200, 180), area, area,
+                DragAction.Move, (_, _, _, _) => true));
+            ((IDockTarget)target).Reset();
+            Assert.Equal(0, target.FillIndicator.Opacity);
+            Assert.True(target.FillOnAreaDrop);
+        });
+    }
+
+    private static void WithTarget(System.Action<Target, Panel> check)
+    {
+        var target = new Target { FillOnAreaDrop = true };
+        var area = new Canvas { Width = 400, Height = 300, DataContext = new DocumentDock(), Background = Brushes.Transparent };
+        DockProperties.SetIsDockTarget(area, true);
+        area.Children.Add(target);
+        area.Children.Add(target.LeftSelector);
+        var window = new Window { Width = 400, Height = 300, Content = area };
+        window.Show();
+        try
+        {
+            window.UpdateLayout();
+            target.Register();
+            check(target, area);
+        }
+        finally { window.Close(); }
+    }
+
+    [AvaloniaTheory]
+    [InlineData(100, 10, false)]
+    [InlineData(100, 100, true)]
+    [InlineData(250, 100, false)]
+    public void 正文边框排除标签栏并服从祖先裁剪(double x, double y, bool expected)
+    {
+        var target = new Target { FillOnAreaDrop = true };
+        var area = new Canvas { Width = 400, Height = 300, DataContext = new DocumentDock() };
+        var content = new Border { Name = "PART_Border", Width = 400, Height = 270 };
+        Canvas.SetTop(content, 30);
+        area.Children.Add(content); area.Children.Add(target);
+        DockProperties.SetIsDockTarget(area, true);
+        var clip = new Canvas { Width = 200, Height = 300, ClipToBounds = true };
+        clip.Children.Add(area);
+        var window = new Window { Width = 400, Height = 300, Content = clip };
+        window.Show();
+        try
+        {
+            window.UpdateLayout(); target.Register();
+            var operation = target.GetDockOperation(new Point(x, y), area, area, DragAction.Move, (_, _, _, _) => true);
+            Assert.Equal(expected ? DockOperation.Fill : DockOperation.Window, operation);
+        }
+        finally { window.Close(); }
+    }
+}
