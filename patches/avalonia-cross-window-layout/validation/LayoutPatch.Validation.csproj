<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <Compile Include="$(RepositoryRoot)/Host/MyAvaloniaManagement.UiTests/AvaloniaLayoutOwnershipUiTests.cs" Link="LayoutOwnershipTests.cs" />
  </ItemGroup>
  <Target Name="UseCandidateRuntime" AfterTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(CandidateRuntime)')" Text="缺少待测运行时。" />
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Avalonia.Base.dll'" />
      <ReferenceCopyLocalPaths Include="$(CandidateRuntime)" />
    </ItemGroup>
  </Target>
</Project>
