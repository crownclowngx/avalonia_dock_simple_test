<Project>
  <PropertyGroup>
    <!--
      产品版本描述用户实际安装和看到的宿主发布，不承担 Plugin SDK 的兼容身份。
      FileVersion 使用四段数字供 Windows 文件属性读取；InformationalVersion 可以由
      SDK 追加源码修订元数据，欢迎页只显示加号前的产品版本。
    -->
    <MyAvaloniaProductVersion>2.0.0</MyAvaloniaProductVersion>
    <MyAvaloniaProductFileVersion>2.0.0.0</MyAvaloniaProductFileVersion>
    <MyAvaloniaProductAssemblyVersion>2.0.0.0</MyAvaloniaProductAssemblyVersion>

    <!--
      V2 不再维护可供插件引用的独立 Host API 版本线。Host AssemblyVersion 跟随产品，
      Plugin SDK 则继续独立表达进程内契约身份；二者不能互相替代。
    -->
    <MyAvaloniaPluginSdkVersion>2.0.0</MyAvaloniaPluginSdkVersion>
    <MyAvaloniaPluginSdkNextMajorVersion>3.0.0</MyAvaloniaPluginSdkNextMajorVersion>
    <MyAvaloniaPluginSdkFileVersion>2.0.0.0</MyAvaloniaPluginSdkFileVersion>
    <MyAvaloniaPluginSdkAssemblyVersion>2.0.0.0</MyAvaloniaPluginSdkAssemblyVersion>
    <!--
      public API 文本基线按 SDK 主版本独立保存。有意破坏必须先建立新的 vN 目录，
      再同步提升包版本、程序集版本和插件清单兼容区间，不能改写旧基线掩盖差异。
    -->
    <MyAvaloniaPluginSdkApiBaseline>v2</MyAvaloniaPluginSdkApiBaseline>

    <!--
      Plugin SDK UI Profile 与宿主使用同一组 UI 依赖事实。基础 SDK 不引用这些实现包；
      可选 UI Profile 在打包时把下列值写成精确 NuGet 区间，避免外部插件在还原时
      自动漂移到宿主未验证的主题版本。
    -->
    <MyAvaloniaAvaloniaUiVersion>12.1.0</MyAvaloniaAvaloniaUiVersion>
    <MyAvaloniaDockUiVersion>12.0.0.2</MyAvaloniaDockUiVersion>
    <MyAvaloniaSemiUiVersion>12.1.0</MyAvaloniaSemiUiVersion>
    <MyAvaloniaUrsaUiVersion>2.1.0</MyAvaloniaUrsaUiVersion>

    <!--
      G1 只建立 V2 目标 schema 和文件名事实，不把它们接入仍在工作的 V1 reader。
      manifest、Document envelope 与 layout 的最终 V2 线格式分别由 G3、G7、G8 一次建立，
      避免在同一个 schemaVersion=2 下先后出现两种结构。
    -->
    <MyAvaloniaV2ManifestSchemaVersion>2</MyAvaloniaV2ManifestSchemaVersion>
    <MyAvaloniaV2DocumentEnvelopeSchemaVersion>2</MyAvaloniaV2DocumentEnvelopeSchemaVersion>
    <MyAvaloniaV2LayoutSchemaVersion>2</MyAvaloniaV2LayoutSchemaVersion>
    <MyAvaloniaV2LayoutFileName>layout-v2.json</MyAvaloniaV2LayoutFileName>

    <!--
      下列值是 G3 前的 V1 编译桥，只用于让当前清单生成器和 loader 在阶段间保持绿色。
      它不是第二套 V2 schema 事实；G3 建立最终 manifest v2 后必须删除。
    -->
    <MyAvaloniaManifestSchemaVersion>1</MyAvaloniaManifestSchemaVersion>
    <MyAvaloniaHostDataRootGeneration>v2</MyAvaloniaHostDataRootGeneration>
  </PropertyGroup>
</Project>
