<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- SDK 发布版本与 CLR 兼容身份分别映射，兼容的次版本不改变 AssemblyVersion。 -->
        <Version>$(MyAvaloniaPluginSdkVersion)</Version>
        <PackageVersion>$(MyAvaloniaPluginSdkVersion)</PackageVersion>
        <FileVersion>$(MyAvaloniaPluginSdkFileVersion)</FileVersion>
        <InformationalVersion>$(MyAvaloniaPluginSdkVersion)</InformationalVersion>
        <AssemblyVersion>$(MyAvaloniaPluginSdkAssemblyVersion)</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia" />
      <PackageReference Include="Avalonia.Desktop" />
      <PackageReference Include="Avalonia.Fonts.Inter" />
      <PackageReference Include="Avalonia.Themes.Fluent" />
      <PackageReference Include="CommunityToolkit.Mvvm" />
      <PackageReference Include="Dock.Avalonia" />
      <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
      <PackageReference Include="Dock.Controls.ProportionalStackPanel" />
      <PackageReference Include="Dock.Controls.Recycling" />
      <PackageReference Include="Dock.Controls.Recycling.Model" />
      <PackageReference Include="Dock.Model.Mvvm" />
      <PackageReference Include="Irihi.Ursa" />
      <PackageReference Include="Irihi.Ursa.Themes.Semi" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="Semi.Avalonia" />
      <PackageReference Include="Xaml.Behaviors" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Chain\" />
    </ItemGroup>

</Project>
