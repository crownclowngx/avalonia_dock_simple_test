<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(MyAvaloniaPluginSdkVersion)</Version>
    <PackageVersion>$(MyAvaloniaPluginSdkVersion)</PackageVersion>
    <FileVersion>$(MyAvaloniaPluginSdkFileVersion)</FileVersion>
    <InformationalVersion>$(MyAvaloniaPluginSdkVersion)</InformationalVersion>
    <AssemblyVersion>$(MyAvaloniaPluginSdkAssemblyVersion)</AssemblyVersion>
    <AssemblyName>MyAvaloniaManagement.PluginSdk.UI</AssemblyName>
    <RootNamespace>MyAvaloniaManagement.PluginSdk.UI</RootNamespace>
    <PackageId>MyAvaloniaManagement.PluginSdk.UI</PackageId>
    <Title>MyAvaloniaManagement Plugin SDK UI</Title>
    <Description>Managed Plugin V3 的 Avalonia 注册与视图贡献契约。</Description>
    <Authors>MyAvaloniaManagement Contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://gitee.com/crownclowngx/avalonia_dock_simple_test.git</RepositoryUrl>
    <PackageProjectUrl>https://gitee.com/crownclowngx/avalonia_dock_simple_test</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>avalonia;plugin;sdk;ui;semi;ursa</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025;RS0036;RS0037;RS0041;RS0048</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAvaloniaManagement.PluginSdk\MyAvaloniaManagement.PluginSdk.csproj" />
    <PackageReference Include="Avalonia" VersionOverride="[$(MyAvaloniaAvaloniaUiVersion)]" />
    <PackageReference Include="Avalonia.Themes.Fluent" VersionOverride="[$(MyAvaloniaAvaloniaUiVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                      VersionOverride="[$(MyAvaloniaDependencyInjectionUiVersion)]" />
    <PackageReference Include="Irihi.Ursa" VersionOverride="[$(MyAvaloniaUrsaUiVersion)]" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" VersionOverride="[$(MyAvaloniaUrsaUiVersion)]" />
    <PackageReference Include="Semi.Avalonia" VersionOverride="[$(MyAvaloniaSemiUiVersion)]" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="ApiCompatibility\$(MyAvaloniaPluginSdkApiBaseline)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="ApiCompatibility\$(MyAvaloniaPluginSdkApiBaseline)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
