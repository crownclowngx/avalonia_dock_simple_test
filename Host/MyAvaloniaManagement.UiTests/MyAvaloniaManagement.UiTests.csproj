<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><MyAvaloniaUseLayoutPatch>true</MyAvaloniaUseLayoutPatch></PropertyGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 外部产物验收显式开启，避免普通开发测试依赖个人安装目录或悄悄跳过用例。
         使用独立 artifacts-path 构建此变体；Gate verify 的默认测试集合保持可重现。 -->
    <Compile Remove="ExternalPluginBinaryAcceptanceTests.cs" Condition="'$(HostExternalPluginAcceptance)' != 'true'" />
    <Compile Remove="ExternalPluginWorkspaceAcceptanceTests.cs" Condition="'$(HostExternalPluginAcceptance)' != 'true'" />
    <Compile Remove="ExternalPluginDashboardAcceptanceTests.cs" Condition="'$(HostExternalPluginAcceptance)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAvaloniaManagement\MyAvaloniaManagement.csproj" />
    <ProjectReference Include="..\..\Plugins\MyPlugTest\MyPlugTest\MyPlugTest.csproj" />
  </ItemGroup>
</Project>
