<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyAvaloniaManagement.ViewModels.Tools"
             xmlns:models="using:MyAvaloniaManagement.Models.Tools"
             xmlns:documentCreation="using:MyAvaloniaManagement.Business.Workspace"
             xmlns:icons="using:MyAvaloniaManagement.Business.Presentation.Icons"
             mc:Ignorable="d"
             d:DesignWidth="260"
             d:DesignHeight="450"
             x:Class="MyAvaloniaManagement.Views.Tools.PlugGroupMenuView"
             x:DataType="vm:PlugGroupMenuViewModel"
             x:Name="PlugGroupMenuControl"
             Classes="host-tool-surface">
    <Grid RowDefinitions="Auto,*">
        <Border Classes="host-tool-toolbar">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="显示方式" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" x:Name="PluginMenuModeSelector"
                          ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" MinWidth="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginMenuModeOption">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsLegacy}" x:Name="PluginMenuScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding CategoryNodes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:CategoryNode">
                    <StackPanel>
                        <Button Classes="host-tool-section"
                                Command="{Binding DataContext.ToggleCategoryExpandCommand, ElementName=PlugGroupMenuControl}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="16,*,Auto">
                                <PathIcon Classes="host-tool-chevron"
                                          Classes.expanded="{Binding IsExpanded}"
                                          Data="{StaticResource HostToolChevronGeometry}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Margin="3,0,6,0"
                                           Text="{Binding CategoryName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Classes="host-tool-secondary"
                                           Text="{Binding Documents.Count}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <ItemsControl ItemsSource="{Binding Documents}"
                                      Margin="18,0,0,0"
                                      IsVisible="{Binding IsExpanded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="documentCreation:DocumentCreationMenuEntry">
                                    <Button Classes="host-tool-row"
                                            Command="{Binding DataContext.CreateDocumentEntryCommand, ElementName=PlugGroupMenuControl}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="17,*">
                                            <icons:HostIconView Width="13"
                                                      Height="13"
                                                      Renderer="{Binding DataContext.Icons, ElementName=PlugGroupMenuControl}"
                                                      Foreground="{DynamicResource AppInfoBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="4,0,5,0"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
        <TreeView Grid.Row="1" x:Name="PluginNavigationTree" IsVisible="{Binding IsTree}"
                  ItemsSource="{Binding TreeNodes}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="models:NavigationTreeNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="models:NavigationTreeNode" ItemsSource="{Binding Children}">
                    <Button Classes="host-tool-row" ToolTip.Tip="{Binding ToolTip}"
                            Command="{Binding DataContext.ActivateTreeNodeCommand, ElementName=PlugGroupMenuControl}"
                            CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="16,*,Auto">
                            <icons:HostIconView Width="13" Height="13" VerticalAlignment="Center"
                                      Source="{Binding IconRequest}"
                                      Renderer="{Binding DataContext.Icons, ElementName=PlugGroupMenuControl}"
                                      Foreground="{DynamicResource AppInfoBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="5,0,4,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Classes="host-tool-secondary"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
