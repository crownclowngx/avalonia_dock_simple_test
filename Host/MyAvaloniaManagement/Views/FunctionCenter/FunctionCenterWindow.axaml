<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyAvaloniaManagement.ViewModels.FunctionCenter"
        xmlns:models="using:MyAvaloniaManagement.Models.Tools"
        xmlns:workspace="using:MyAvaloniaManagement.Business.Workspace"
        xmlns:icons="using:MyAvaloniaManagement.Business.Presentation.Icons"
        x:Class="MyAvaloniaManagement.Views.FunctionCenter.FunctionCenterWindow"
        x:Name="FunctionCenterControl"
        x:DataType="vm:FunctionCenterViewModel"
        Title="新建文档" Width="920" Height="640" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppPanelBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <StackPanel Spacing="12" Margin="0,0,0,18">
            <TextBlock Text="选择要使用的功能" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="浏览业务分类，或搜索功能名称、说明与分类路径。"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" />
            <TextBox x:Name="FunctionSearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索全部功能…" IsEnabled="{Binding IsIdle}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="210,18,*">
            <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                <Grid RowDefinitions="Auto,*" IsEnabled="{Binding IsIdle}">
                    <Button Content="全部功能" Command="{Binding ShowAllCommand}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                    <TreeView Grid.Row="1" x:Name="FunctionCategoryTree" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="models:NavigationTreeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="models:NavigationTreeNode" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding ToolTip}"
                                           TextTrimming="CharacterEllipsis" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ResultsTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ResultCount}" Margin="8,0,0,0"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </Grid>
                <ListBox Grid.Row="1" x:Name="FunctionItemsList" ItemsSource="{Binding VisibleItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="workspace:DocumentCreationItem">
                            <Grid ColumnDefinitions="36,12,*" ToolTip.Tip="{Binding Description}">
                                <icons:HostIconView Width="28" Height="28" VerticalAlignment="Center"
                                          Source="{Binding IconRequest}"
                                          Renderer="{Binding DataContext.Icons, ElementName=FunctionCenterControl}"
                                          Foreground="{DynamicResource AppInfoBrush}" />
                                <StackPanel Grid.Column="2" Spacing="5">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                    <TextBlock Text="{Binding CategoryPath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="没有找到匹配的功能" IsVisible="{Binding HasNoResults}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppSecondaryTextBrush}" IsHitTestVisible="False" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
            <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppErrorBrush}" Margin="0,0,0,10" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="正在创建文档…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="CancelCreationButton" Content="取消" MinWidth="82"
                        IsEnabled="{Binding IsIdle}" Margin="0,0,10,0" />
                <Button Grid.Column="2" x:Name="CreateDocumentButton" Content="创建" MinWidth="82"
                        Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" IsDefault="True" />
            </Grid>
        </Grid>
    </Grid>
</Window>
