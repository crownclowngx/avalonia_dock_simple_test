<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyAvaloniaManagement.ViewModels.PluginStatus"
        xmlns:models="clr-namespace:MyAvaloniaManagement.Models.Plugins"
        xmlns:compat="clr-namespace:MyAvaloniaManagement.Business.Compatibility"
        x:Class="MyAvaloniaManagement.Views.PluginStatus.PluginStatusWindow"
        x:DataType="vm:PluginStatusWindowViewModel"
        Title="插件看板" Width="1200" Height="800" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.summary, Border.details-card">
            <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.summary"><Setter Property="Padding" Value="10" /></Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.status-mark">
            <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}" />
        </Style>
        <Style Selector="TextBlock.status-mark.problem">
            <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
        </Style>
    </Window.Styles>
    <!-- 概览、筛选、主从详情各自拥有布局空间；正文采用滚动，长诊断不会挤出底部操作。 -->
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Spacing="5">
                <TextBlock Text="插件看板" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="当前状态 · 版本与产物 · 分层验收证据" Classes="secondary" />
            </StackPanel>
            <WrapPanel Grid.Column="1" MaxWidth="300" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Content="刷新状态" Command="{Binding RefreshCommand}" Margin="4" />
                <Button x:Name="InspectArtifactsButton" Content="检查安装产物" Command="{Binding CheckArtifactsCommand}" IsEnabled="{Binding CanInspect}" Margin="4" />
                <Button x:Name="ImportReportButton" Content="导入报告…" Click="ImportReportClick" IsEnabled="{Binding CanInspect}" Margin="4" />
                <Button x:Name="ExportSummaryButton" Content="导出摘要…" Click="ExportSummaryClick" IsEnabled="{Binding HasSelection}" Margin="4" />
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,12,*,12,*" Margin="0,0,0,10">
            <Border Classes="summary"><StackPanel Spacing="5">
                <TextBlock Text="已发现" Classes="secondary" />
                <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="SemiBold" />
            </StackPanel></Border>
            <Border Grid.Column="2" Classes="summary"><StackPanel Spacing="5">
                <TextBlock Text="✓ 可用" Foreground="{DynamicResource AppInfoBrush}" />
                <TextBlock Text="{Binding AvailableCount}" FontSize="28" FontWeight="SemiBold" />
            </StackPanel></Border>
            <Border Grid.Column="4" Classes="summary" ToolTip.Tip="包含加载失败、生命周期失败，以及存在警告或错误记录的插件；可用插件也可能有警告。">
                <StackPanel Spacing="5">
                    <TextBlock Text="⚠ 异常 / 警告" Foreground="{DynamicResource AppWarningBrush}" />
                    <TextBlock Text="{Binding ProblemCount}" FontSize="28" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,12,110" Margin="0,0,0,12">
            <TextBox x:Name="PluginSearchBox" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="搜索插件 ID、程序集或错误码…" />
            <ComboBox x:Name="PluginFilterBox" Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" ToolTip.Tip="筛选插件状态" />
        </Grid>
        <Border Grid.Row="3" IsVisible="{Binding HasError}" Background="{DynamicResource AppWarningPanelBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="4" x:Name="PluginBody" ColumnDefinitions="2*,16,3*">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="{Binding ResultsText}" Classes="secondary" Margin="0,0,0,8" />
                <ListBox x:Name="PluginItemsList" Grid.Row="1" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,12" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate><DataTemplate x:DataType="models:PluginStatusItem">
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Text="{Binding StatusSymbol}" FontSize="18" Classes="status-mark" Classes.problem="{Binding HasProblem}" />
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{Binding PluginId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PluginId}" />
                                <TextBlock Text="{Binding VersionText, StringFormat='版本 {0}'}" Classes="secondary" FontSize="12" />
                                <TextBlock Text="{Binding StatusLabel}" Classes="status-mark" Classes.problem="{Binding HasProblem}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Column="1" Width="1" Background="{DynamicResource AppDividerBrush}" />
            <TabControl x:Name="DashboardTabs" Grid.Column="2">
                <TabItem Header="概览">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="0,12,10,0">
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInspecting}" Height="3" />
                            <TextBlock Text="{Binding EvidenceNotice}" Classes="secondary" />
                            <TextBlock Text="{Binding EvidenceTimeText}" Classes="secondary" FontSize="11" />
                            <Border Classes="details-card"><StackPanel Spacing="8">
                                <TextBlock Text="Host 运行环境" Classes="section-title" />
                                <SelectableTextBlock Text="{Binding HostText}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel></Border>
                            <Border Classes="details-card"><StackPanel Spacing="8">
                                <TextBlock Text="当前插件产物" Classes="section-title" />
                                <SelectableTextBlock Text="{Binding SelectedItem.PluginId}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedItem.VersionText, StringFormat='业务版本：{0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedItem.CompatibilityText, StringFormat='声明范围：{0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BuildSdkText, StringFormat='编译 SDK 包：{0}'}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedItem.StatusText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ArtifactSummaryText}" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="{Binding CurrentEvidenceText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SuggestionText}" Classes="secondary" />
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="兼容矩阵">
                    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                        <StackPanel Spacing="5" Margin="0,0,0,10">
                            <TextBlock Text="行是插件产物，列是 Host 构建与环境；悬停查看身份。" Classes="secondary" FontSize="12" />
                            <WrapPanel>
                                <ComboBox x:Name="EvidenceFilterBox" ItemsSource="{Binding EvidenceFilters}" SelectedItem="{Binding SelectedEvidenceFilter, Mode=TwoWay}" Width="150" Margin="0,0,10,0" ToolTip.Tip="按已显示列的最新结果筛选" />
                                <CheckBox x:Name="ShowHistoryBox" Content="展开历史构建" IsChecked="{Binding ShowHistory, Mode=TwoWay}" />
                            </WrapPanel>
                            <TextBlock Text="无报告 · 导入报告或检查安装产物后显示矩阵。" IsVisible="{Binding HasNoMatrix}" Classes="secondary" />
                            <TextBlock Text="没有符合当前证据筛选的产物。" IsVisible="{Binding HasNoMatrixRows}" Classes="secondary" />
                        </StackPanel>
                        <ScrollViewer x:Name="CompatibilityMatrixScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel IsVisible="{Binding !HasNoMatrix}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="插件 / 产物摘要" Width="230" Padding="8" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding MatrixColumns}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="compat:CompatibilityMatrixColumn">
                                            <Border Width="220" Classes="details-card" Margin="0,0,6,6" ToolTip.Tip="{Binding Detail}">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding MatrixRows}"><ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="compat:CompatibilityMatrixRow">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Width="230" Margin="0,8,0,12" Spacing="6">
                                                <TextBlock Text="{Binding PluginId}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,0" />
                                                <TextBlock Text="{Binding ArtifactText}" Classes="secondary" FontSize="11" Margin="8,0" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="compat:CompatibilityMatrixCell">
                                                    <Border Width="220" Classes="details-card" Margin="0,0,6,6" ToolTip.Tip="{Binding Detail}">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="详情与诊断">
                <ScrollViewer x:Name="PluginDetailsScroll" IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                <StackPanel Spacing="16">
                    <Expander Header="构建身份、产物与编译依赖" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                        <StackPanel Spacing="12">
                            <SelectableTextBlock Text="{Binding HostIdentityText}" TextWrapping="Wrap" FontSize="12" />
                            <SelectableTextBlock Text="{Binding ArtifactText}" TextWrapping="Wrap" FontSize="12" />
                            <SelectableTextBlock Text="{Binding BuildText}" TextWrapping="Wrap" FontSize="12" />
                            <SelectableTextBlock Text="{Binding ReferenceText}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Spacing="8" Margin="0,0,10,0">
                        <TextBlock Text="验收历史" Classes="section-title" />
                        <TextBlock Text="没有该插件的验收报告；不影响当前会话状态。" IsVisible="{Binding HasNoEvidence}" Classes="secondary" />
                        <ItemsControl ItemsSource="{Binding EvidenceRows}"><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="compat:CompatibilityEvidenceRow">
                                <Border Classes="details-card" Margin="0,0,0,8"><StackPanel Spacing="5">
                                    <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MatchText}" Classes="secondary" />
                                    <TextBlock Text="{Binding HostBuild, StringFormat='Host {0}'}" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{Binding TimeText}" Classes="secondary" FontSize="11" />
                                    <TextBlock Text="{Binding Source}" Classes="secondary" FontSize="11" />
                                    <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel></Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                <StackPanel x:Name="PluginDetails" Spacing="16" Margin="0,0,10,0" DataContext="{Binding SelectedItem}" x:DataType="models:PluginStatusItem">
                    <StackPanel Spacing="7">
                        <SelectableTextBlock Text="{Binding PluginId}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Classes="details-card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="基本信息" Classes="section-title" />
                            <SelectableTextBlock Text="{Binding VersionText, StringFormat='版本：{0}'}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding CompatibilityText, StringFormat='兼容：{0}'}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding AssemblyName, StringFormat='程序集：{0}'}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DurationText, StringFormat='生命周期耗时：{0}'}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AvailabilityText, StringFormat='可用性：{0}'}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding Detail}" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="贡献信息" Classes="section-title" />
                        <TextBlock Text="{Binding ContributionSummary}" Classes="secondary" FontSize="12" />
                        <TextBlock Text="没有已提交的文档、工具、命令或工作流动作声明。" IsVisible="{Binding !HasContributions}" Classes="secondary" />
                        <ItemsControl ItemsSource="{Binding Contributions}"><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PluginContributionItem">
                                <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Kind}" Classes="secondary" FontSize="12" />
                                        <SelectableTextBlock Text="{Binding Id}" TextWrapping="Wrap" FontSize="12" />
                                        <TextBlock Text="{Binding AvailabilityText}" Classes="secondary" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="诊断记录" Classes="section-title" />
                        <TextBlock Text="当前会话没有该插件的诊断记录。" IsVisible="{Binding !HasDiagnostics}" Classes="secondary" />
                        <ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PluginDiagnosticItem">
                                <Border Classes="details-card" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding TimeText}" Classes="secondary" FontSize="11" />
                                        <WrapPanel>
                                            <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding PhaseText}" Classes="secondary" />
                                        </WrapPanel>
                                        <SelectableTextBlock Text="{Binding Code}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        <SelectableTextBlock Text="{Binding TechnicalDetail}" Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
                </TabItem>
            </TabControl>
            <TextBlock Grid.ColumnSpan="3" Text="{Binding EmptyText}" IsVisible="{Binding HasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="330" TextWrapping="Wrap" Classes="secondary" IsHitTestVisible="False" />
        </Grid>
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <StackPanel VerticalAlignment="Center" Spacing="3" Margin="0,0,12,0">
                <TextBlock Text="{Binding UpdatedText}" Classes="secondary" FontSize="11" />
                <TextBlock x:Name="CopyFeedbackText" Text="{Binding CopyFeedback}" Classes="secondary" FontSize="11" />
            </StackPanel>
            <Button x:Name="CopyDiagnosticsButton" Grid.Column="1" Content="复制诊断信息" IsEnabled="{Binding HasSelection}" Click="CopyDiagnosticsClick" />
        </Grid>
    </Grid>
</Window>
