<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bindings="using:MyAvaloniaManagement.ViewModels.Bindings"
        xmlns:design="using:MyAvaloniaManagement.ViewModels.Design"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:MyAvaloniaManagement.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyAvaloniaManagement.Views.MainWindow"
        x:DataType="bindings:IMainWindowViewBindings"
        x:Name="MainWindowView"
        WindowState="Normal" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource AppPrimaryTextBrush}"
        BorderThickness="1" BorderBrush="{DynamicResource DockThemeBorderLowBrush}"
        Icon="/Assets/avalonia-logo.ico"
        Title="管理系统"
        ExtendClientAreaToDecorationsHint="False"
        WindowDecorations="Full">

    <Design.DataContext>
        <design:MainWindowDesignData />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="StartupWarningBanner" IsVisible="False" Padding="12,6"
                Background="{DynamicResource AppWarningPanelBrush}">
            <DockPanel>
                <Button x:Name="StartupWarningDetails" DockPanel.Dock="Right" Content="查看插件看板" />
                <TextBlock x:Name="StartupWarningText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <views:MainView Grid.Row="1" />
        <Border x:Name="ContentFullscreenLayer"
                Grid.RowSpan="2"
                IsVisible="False"
                Background="Black"
                ZIndex="10000">
            <ContentControl x:Name="ContentFullscreenHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
        <Border x:Name="CommandPaletteLayer"
                Grid.RowSpan="2"
                IsVisible="False"
                Background="#99000000"
                ZIndex="20000">
            <views:CommandPaletteView x:Name="CommandPaletteHost"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"
                                      Margin="24,72,24,24" />
        </Border>
    </Grid>
</Window>
