<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <StreamGeometry x:Key="HostToolFolderOpenGeometry">M2,4 H8 L10,6 H18 V8 H5 L3,16 H1 Z M5,9 H19 L16,17 H2 Z</StreamGeometry>
        <StreamGeometry x:Key="HostToolModuleGeometry">M2,2 H8 V8 H2 Z M10,2 H16 V8 H10 Z M2,10 H8 V16 H2 Z M10,10 H16 V16 H10 Z</StreamGeometry>
        <StreamGeometry x:Key="HostToolChevronGeometry">M5,3 L10,8 L5,13</StreamGeometry>
    </Styles.Resources>

    <Style Selector="UserControl.host-tool-surface">
        <Setter Property="Background" Value="{DynamicResource DockSurfaceSidebarBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Border.host-tool-toolbar">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="Button.host-tool-icon-button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.host-tool-icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}" />
    </Style>

    <Style Selector="Button.host-tool-row">
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.host-tool-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    </Style>

    <Style Selector="Button.host-tool-section">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.host-tool-section:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    </Style>

    <Style Selector="Border.host-tool-list-row">
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.host-tool-list-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    </Style>

    <Style Selector="TextBlock.host-tool-secondary">
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="PathIcon.host-tool-chevron">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="0" />
        </Setter>
    </Style>
    <Style Selector="PathIcon.host-tool-chevron.expanded">
        <Setter Property="RenderTransform">
            <RotateTransform Angle="90" />
        </Setter>
    </Style>
</Styles>
