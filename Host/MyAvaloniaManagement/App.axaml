<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="clr-namespace:Ursa.Themes.Semi;assembly=Ursa.Themes.Semi"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MyAvaloniaManagement.App"
             xmlns:local="using:MyAvaloniaManagement"
             xmlns:behaviors="using:MyAvaloniaManagement.Behaviors"
             xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
             xmlns:helpers="using:MyAvaloniaManagement.Business.Helpers"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

             <Application.Resources>
                 <ResourceDictionary>
                     <helpers:DocumentControlRecycling x:Key="ControlRecyclingKey" />
                     <ResourceDictionary.ThemeDictionaries>
                         <ResourceDictionary x:Key="Light">
                             <ResourceDictionary.MergedDictionaries>
                                 <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/VsCodeLight.axaml" />
                             </ResourceDictionary.MergedDictionaries>
                             <SolidColorBrush x:Key="AppPanelBrush" Color="#FFF5F5F5" />
                             <SolidColorBrush x:Key="AppSubtlePanelBrush" Color="#0D000000" />
                             <SolidColorBrush x:Key="AppToolSelectedBrush" Color="#18007ACC" />
                             <SolidColorBrush x:Key="AppDividerBrush" Color="#1F000000" />
                             <SolidColorBrush x:Key="AppBorderBrush" Color="#33000000" />
                             <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FF666666" />
                             <SolidColorBrush x:Key="AppInfoBrush" Color="#FF0078A8" />
                             <SolidColorBrush x:Key="AppWarningBrush" Color="#FF9A6700" />
                             <SolidColorBrush x:Key="AppErrorBrush" Color="#FFC42B1C" />
                             <!--
                             Error 表示错误状态文字，Danger 表示破坏性操作；当前调色板相同，
                             但保留不同语义键，允许未来在不修改插件 XAML 的前提下分别调整。
                             -->
                             <SolidColorBrush x:Key="AppDangerBrush" Color="#FFC42B1C" />
                             <SolidColorBrush x:Key="AppWarningPanelBrush" Color="#FFFFF4CE" />
                             <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#FFC28A00" />
                             <SolidColorBrush x:Key="AppReadMessageBackgroundBrush" Color="#FFDCEEFF" />
                             <SolidColorBrush x:Key="AppUnreadMessageBackgroundBrush" Color="#FFF5F5F5" />
                         </ResourceDictionary>
                         <ResourceDictionary x:Key="Dark">
                             <ResourceDictionary.MergedDictionaries>
                                 <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/VsCodeDark.axaml" />
                             </ResourceDictionary.MergedDictionaries>
                             <SolidColorBrush x:Key="AppPanelBrush" Color="#FF252525" />
                             <SolidColorBrush x:Key="AppSubtlePanelBrush" Color="#14FFFFFF" />
                             <SolidColorBrush x:Key="AppToolSelectedBrush" Color="#303794FF" />
                             <SolidColorBrush x:Key="AppDividerBrush" Color="#26FFFFFF" />
                             <SolidColorBrush x:Key="AppBorderBrush" Color="#3DFFFFFF" />
                             <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FFB8B8B8" />
                             <SolidColorBrush x:Key="AppInfoBrush" Color="#FF4CC2F1" />
                             <SolidColorBrush x:Key="AppWarningBrush" Color="#FFFFB74D" />
                             <SolidColorBrush x:Key="AppErrorBrush" Color="#FFFF6B6B" />
                             <SolidColorBrush x:Key="AppDangerBrush" Color="#FFFF6B6B" />
                             <SolidColorBrush x:Key="AppWarningPanelBrush" Color="#FF3A2A16" />
                             <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#FFD89B3C" />
                             <SolidColorBrush x:Key="AppReadMessageBackgroundBrush" Color="#FF143A52" />
                             <SolidColorBrush x:Key="AppUnreadMessageBackgroundBrush" Color="#FF252525" />
                         </ResourceDictionary>
                     </ResourceDictionary.ThemeDictionaries>
                 </ResourceDictionary>
             </Application.Resources>
             <Application.Styles>
                 <FluentTheme />
                 <semi:SemiTheme Locale="zh-CN" />
                 <semi:SemiPopupAnimations/>
                 <u-semi:UrsaSemiTheme Locale="zh-CN" />
                 <DockFluentTheme DensityStyle="Compact" />
                 <StyleInclude Source="avares://MyAvaloniaManagement/Styles/HostToolStyles.axaml" />

                 <Style Selector="DockControl">
                     <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource ControlRecyclingKey}" />
                 </Style>

                 <!--
                 浮动内容继续使用独立系统窗口。强制保留原生标题栏，可以避开 Dock 12.0.0.2
                 在自定义 Chrome 拖动结束事件丢失时残留半完成状态的问题。
                 -->
                 <Style Selector="dock|HostWindow">
                     <Setter Property="WindowDecorations" Value="Full" />
                     <Setter Property="ExtendClientAreaToDecorationsHint" Value="False" />
                     <Setter Property="ToolChromeControlsWholeWindow" Value="False" />
                     <Setter Property="DocumentChromeControlsWholeWindow" Value="False" />
                 </Style>

                 <!-- 浮动文档通过系统标题栏移动；具体标签仍可执行排序、浮动和重新停靠。 -->
                 <Style Selector="dock|HostWindow dock|DocumentTabStrip">
                     <Setter Property="EnableWindowDrag" Value="False" />
                 </Style>

                 <!--
                 Dock 的标签排序辅助器没有在初始阶段真正捕获指针。宿主保护层只补齐指针所有权，
                 不接管 Dock 的排序、浮动或停靠决策。
                 -->
                 <Style Selector="dock|DocumentTabStripItem">
                     <Setter Property="behaviors:DockTabPointerCaptureGuard.IsEnabled" Value="True" />
                 </Style>
                 <Style Selector="dock|ToolTabStripItem">
                     <Setter Property="behaviors:DockTabPointerCaptureGuard.IsEnabled" Value="True" />
                 </Style>
                 <Style Selector="dock|ToolPinItemControl">
                     <Setter Property="behaviors:DockTabPointerCaptureGuard.IsEnabled" Value="True" />
                 </Style>
             </Application.Styles>
</Application>
