<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u-semi="clr-namespace:Ursa.Themes.Semi;assembly=Ursa.Themes.Semi"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="MyAvaloniaManagement.App"
             xmlns:local="using:MyAvaloniaManagement"
             xmlns:helpers="using:MyAvaloniaManagement.Business.Helpers"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

             <Application.DataTemplates>
                 <local:ViewLocator />
             </Application.DataTemplates>
             <Application.Resources>
                 <helpers:DocumentControlRecycling x:Key="ControlRecyclingKey" />
             </Application.Resources>
             <Application.Styles>
                 <FluentTheme />
                 <semi:SemiTheme Locale="zh-CN" />
                 <semi:SemiPopupAnimations/>
                 <u-semi:UrsaSemiTheme Locale="zh-CN" />
                 <DockFluentTheme />

                 <Style Selector="DockControl">
                     <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource ControlRecyclingKey}" />
                 </Style>
             </Application.Styles>
</Application>
