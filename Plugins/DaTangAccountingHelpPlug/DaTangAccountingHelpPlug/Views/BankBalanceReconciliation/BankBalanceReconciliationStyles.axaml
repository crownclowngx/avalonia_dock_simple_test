<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 样式仅通过 recon-* 类名作用于本业务，避免污染插件内既有的发票 Document。 -->
    <Style Selector="Border.recon-page">
        <Setter Property="MaxWidth" Value="1120" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style Selector="Border.recon-header">
        <Setter Property="Padding" Value="0,0,0,11" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.recon-section">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Border.recon-result">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="TextBlock.recon-title">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.recon-section-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.recon-caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.recon-field-label">
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBox.recon-input, ComboBox.recon-input, DatePicker.recon-input">
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.recon-button">
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="Padding" Value="11,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="ProgressBar.recon-progress">
        <Setter Property="Height" Value="4" />
    </Style>

    <Style Selector="Expander.recon-expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="ListBox.recon-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.recon-list ListBoxItem">
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</Styles>
