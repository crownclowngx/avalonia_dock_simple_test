<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- 插件只声明自身发布事实；清单、版本映射和部署由统一协议负责。 -->
        <ManagedPlugin>true</ManagedPlugin>
        <ManagedPluginId>myavalonia.plugin.datang-accounting-help</ManagedPluginId>
        <ManagedPluginDirectoryName>DaTang</ManagedPluginDirectoryName>
        <PluginVersion>3.0.0</PluginVersion>
        <ManagedPluginRuntimeIdentifier>win-x64</ManagedPluginRuntimeIdentifier>
        <ManagedPluginEntryType>DaTangAccountingHelpPlug.Plugin.DaTangAccountingHelpPluginModule</ManagedPluginEntryType>
        <ManagedPluginSdkMinInclusive>$(MyAvaloniaPluginSdkVersion)</ManagedPluginSdkMinInclusive>
        <ManagedPluginSdkMaxExclusive>$(MyAvaloniaPluginSdkNextMajorVersion)</ManagedPluginSdkMaxExclusive>
    </PropertyGroup>

    <ItemGroup>
      <!-- Core 与 UI 契约由 Host 默认加载上下文提供，不能复制进插件私有目录。 -->
      <ProjectReference Include="..\..\..\Host\MyAvaloniaManagement.PluginSdk\MyAvaloniaManagement.PluginSdk.csproj" Private="false" />
      <ProjectReference Include="..\..\..\Host\MyAvaloniaManagement.PluginSdk.UI\MyAvaloniaManagement.PluginSdk.UI.csproj" Private="false" />
    </ItemGroup>

    <ItemGroup>
      <!-- 插件 ViewModel 的实现依赖显式归属插件，而不是依赖 SDK 的传递引用。 -->
      <PackageReference Include="CommunityToolkit.Mvvm" />
      <PackageReference Include="EPPlus" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
      <!-- LogicalName 固定后，ProfileLoader 不依赖构建目录或插件部署路径。 -->
      <EmbeddedResource Include="Resources\BankBalanceReconciliation\reconciliation-profiles.json"
                        LogicalName="DaTangAccountingHelpPlug.Resources.BankBalanceReconciliation.reconciliation-profiles.json" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Styles\" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Styles/**" />
    </ItemGroup>

    <ItemGroup>
      <!-- EPPlus 的业务依赖由插件拥有；宿主共享的 DI、Avalonia 和 SDK 不进入目录。 -->
      <ManagedPluginPrivatePackage Include="EPPlus;EPPlus.Interfaces;Microsoft.IO.RecyclableMemoryStream;System.Security.Cryptography.Pkcs;System.Security.Cryptography.Xml" />
    </ItemGroup>
</Project>
