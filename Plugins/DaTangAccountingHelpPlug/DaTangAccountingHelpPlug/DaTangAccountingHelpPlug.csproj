<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Host\MyAvaloniaManagementCommon\MyAvaloniaManagementCommon.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="plugin.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="EPPlus" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
      <!-- LogicalName 固定后，ProfileLoader 不依赖构建目录或插件部署路径。 -->
      <EmbeddedResource Include="Resources\BankBalanceReconciliation\reconciliation-profiles.json"
                        LogicalName="DaTangAccountingHelpPlug.Resources.BankBalanceReconciliation.reconciliation-profiles.json" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Styles\" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Styles/**" />
    </ItemGroup>

    <!-- 构建后将插件及其私有运行时依赖部署到宿主 Controls/DaTang 目录。 -->
    <PropertyGroup>
        <HostProjectOutputDir>$(MSBuildThisFileDirectory)..\..\..\Host\MyAvaloniaManagement\bin\$(Configuration)\$(TargetFramework)</HostProjectOutputDir>
        <PluginDeployDir>$(HostProjectOutputDir)\Controls\DaTang</PluginDeployDir>
    </PropertyGroup>

    <Target Name="DeployDaTangPluginToHost"
            AfterTargets="Build"
            DependsOnTargets="ResolveReferences"
            Condition="'$(SkipPluginDeploy)' != 'true'">
        <ItemGroup>
            <DaTangPluginFiles Include="$(TargetPath)" />
            <DaTangPluginFiles Include="$(TargetDir)$(AssemblyName).pdb"
                               Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
            <DaTangPluginFiles Include="$(TargetDir)$(AssemblyName).deps.json"
                               Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
            <DaTangPluginFiles Include="$(TargetDir)plugin.manifest.json" />

            <!--
              宿主已提供 Avalonia、Dock、Common、DI 和 Microsoft.Extensions.Configuration。
              此处只部署 EPPlus 在普通桌面宿主中不能由共享运行时满足的私有依赖。
            -->
            <DaTangPluginManaged Include="@(RuntimeCopyLocalItems)"
                                 Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'EPPlus' Or
                                            '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'EPPlus.Interfaces' Or
                                            '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.IO.RecyclableMemoryStream' Or
                                            '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'System.Security.Cryptography.Pkcs' Or
                                            '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'System.Security.Cryptography.Xml'" />
        </ItemGroup>

        <!-- 清理旧目录，避免依赖升级后残留已删除或改名的程序集。 -->
        <RemoveDir Directories="$(PluginDeployDir)" />
        <MakeDir Directories="$(PluginDeployDir)" />
        <Copy SourceFiles="@(DaTangPluginFiles)"
              DestinationFolder="$(PluginDeployDir)"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(DaTangPluginManaged)"
              DestinationFiles="@(DaTangPluginManaged->'$(PluginDeployDir)\%(DestinationSubPath)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
