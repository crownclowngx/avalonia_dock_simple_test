<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MySmallTools\MySmallTools.csproj"
                      AdditionalProperties="SkipPluginDeploy=true" />
    <ProjectReference Include="..\MySmallTools.SecurityBenchmarks\MySmallTools.SecurityBenchmarks.csproj"
                      ReferenceOutputAssembly="true"
                      AdditionalProperties="SkipPluginDeploy=true" />
  </ItemGroup>
  <ItemGroup>
    <None Update="TestAssets\RealMedia\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestAssets\Secvid03Vectors\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
