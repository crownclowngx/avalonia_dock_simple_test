<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="clr-namespace:MyAvaloniaManagementCommon.Behaviors;assembly=MyAvaloniaManagementCommon"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MySmallTools.Views.SecretVideoPlayer.VideoPlayerControl"
             x:Name="PlayerRoot"
             Focusable="True">
  <UserControl.Styles>
    <StyleInclude Source="avares://MySmallTools/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>

  <!--
    PlayerShell 是普通模式和窗口内容区全屏共同使用的唯一播放器视觉树。
    全屏时 code-behind 只迁移该实例，不复制 EmbeddedVideoSurface，避免一个 MediaPlayer
    同时绑定两个 HWND。
  -->
  <ContentControl x:Name="NormalPlaceholder"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
  <Grid x:Name="PlayerShell"
        RowDefinitions="Auto,*,Auto,Auto,Auto,Auto"
        RowSpacing="3"
        Background="{DynamicResource DockThemeBackgroundBrush}">
    <Border Grid.Row="0" IsVisible="{Binding !IsPlaybackAvailable}"
            Background="#3A2A16" BorderBrush="#D89B3C" BorderThickness="1"
            CornerRadius="4" Padding="10" Margin="4,2">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
            ColumnSpacing="10" RowSpacing="4">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DeploymentIssueText}"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Grid.Row="0" Grid.Column="1" Content="重新检测"
                Command="{Binding RetryDeploymentCheckCommand}" />
        <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2"
                             Text="{Binding DeploymentCheckedPath}"
                             FontFamily="Consolas" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Text="{Binding DeploymentSuggestedAction}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- 原生视频表面单独占据内容区；Avalonia 控件不得覆盖其 HWND。 -->
    <Border Grid.Row="1" Background="Black" CornerRadius="4" ClipToBounds="True">
      <local:EmbeddedVideoSurface x:Name="VideoSurface" />
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
          Margin="4,2" ColumnSpacing="10" RowSpacing="2">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusMessage}" Classes="StatusText"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BufferInfo}" Classes="Caption"
                 IsVisible="{Binding BufferInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                   IsVisible="{Binding IsMediaTransitioning}" IsIndeterminate="True" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="4,0" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" VerticalAlignment="Center"
                 FontFamily="Consolas" Classes="Caption" />
      <Slider x:Name="ProgressSlider" Grid.Column="1" Value="{Binding Position}"
              Minimum="0" Maximum="100" IsEnabled="{Binding IsSeekable}"
              TickFrequency="1" IsSnapToTickEnabled="False"
              AutomationProperties.Name="视频播放进度">
        <i:Interaction.Behaviors>
          <behaviors:HandledEventsAwareBehavior EventName="PointerPressed"
                                                Command="{Binding StartSliderDragCommand}"
                                                HandledEventsToo="True" />
          <behaviors:HandledEventsAwareBehavior EventName="PointerReleased"
                                                Command="{Binding EndSliderDragCommand}"
                                                HandledEventsToo="True" />
        </i:Interaction.Behaviors>
      </Slider>
      <TextBlock Grid.Column="2" Text="{Binding TotalTime}" VerticalAlignment="Center"
                 FontFamily="Consolas" Classes="Caption" />
    </Grid>

    <Border Grid.Row="4" Classes="TaskFooter" Padding="4,5,4,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Button Content="⏮"
                  Command="{Binding #PlayerRoot.NavigationContext.PreviousCommand}"
                  IsVisible="{Binding #PlayerRoot.HasNavigationContext}"
                  IsEnabled="{Binding #PlayerRoot.NavigationContext.CanNavigatePrevious}"
                  Classes="IconButton" ToolTip.Tip="播放当前筛选列表中的上一项"
                  AutomationProperties.Name="上一项" />
          <Button Content="▶" Command="{Binding PlayCommand}" IsVisible="{Binding !IsPlaying}"
                  Classes="IconButton" ToolTip.Tip="播放" AutomationProperties.Name="播放" />
          <Button Content="⏸" Command="{Binding PauseCommand}" IsVisible="{Binding IsPlaying}"
                  Classes="IconButton" ToolTip.Tip="暂停" AutomationProperties.Name="暂停" />
          <Button Content="■" Command="{Binding StopCommand}" Classes="IconButton"
                  ToolTip.Tip="停止" AutomationProperties.Name="停止" />
          <Button Content="⏭"
                  Command="{Binding #PlayerRoot.NavigationContext.NextCommand}"
                  IsVisible="{Binding #PlayerRoot.HasNavigationContext}"
                  IsEnabled="{Binding #PlayerRoot.NavigationContext.CanNavigateNext}"
                  Classes="IconButton" ToolTip.Tip="播放当前筛选列表中的下一项"
                  AutomationProperties.Name="下一项" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="音量" VerticalAlignment="Center" Classes="Caption" />
          <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="96"
                  TickFrequency="10" IsSnapToTickEnabled="False"
                  AutomationProperties.Name="音量" />
          <TextBlock Text="{Binding Volume, StringFormat={}{0:F0}%}" VerticalAlignment="Center"
                     FontFamily="Consolas" Classes="Caption" MinWidth="34" />
          <Button Content="⛶" Command="{Binding ToggleFullscreenCommand}"
                  Classes="IconButton" ToolTip.Tip="切换窗口内容区全屏（Esc 退出）"
                  AutomationProperties.Name="切换全屏" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="5" Classes="TaskFooter" Padding="4,2,4,5">
      <Grid ColumnDefinitions="Auto,120,Auto,*,Auto,*,Auto" ColumnSpacing="6">
        <TextBlock Grid.Column="0" Text="倍速" Classes="Caption"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding AvailableRates}"
                  SelectedItem="{Binding SelectedRate}"
                  IsEnabled="{Binding !IsMediaTransitioning}"
                  ToolTip.Tip="选择当前 Document 的播放速度；切换媒体后继续使用"
                  AutomationProperties.Name="播放倍速" />

        <TextBlock Grid.Column="2" Text="音轨" Classes="Caption"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Column="3"
                  ItemsSource="{Binding AudioTracks}"
                  SelectedItem="{Binding SelectedAudioTrack}"
                  IsEnabled="{Binding HasAudioTracks}"
                  PlaceholderText="无音轨"
                  ToolTip.Tip="选择当前媒体的音轨"
                  MinWidth="120"
                  AutomationProperties.Name="音轨">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="4" Text="字幕" Classes="Caption"
                   VerticalAlignment="Center" />
        <ComboBox Grid.Column="5"
                  ItemsSource="{Binding SubtitleTracks}"
                  SelectedItem="{Binding SelectedSubtitleTrack}"
                  IsEnabled="{Binding !IsMediaTransitioning}"
                  ToolTip.Tip="选择当前媒体的字幕；关闭字幕对应稳定 ID -1"
                  MinWidth="120"
                  AutomationProperties.Name="字幕轨">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <CheckBox Grid.Column="6"
                  Content="连续播放"
                  IsVisible="{Binding #PlayerRoot.HasNavigationContext}"
                  IsChecked="{Binding #PlayerRoot.NavigationContext.IsContinuousPlaybackEnabled}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="自然播放结束后播放当前筛选列表中的下一项；列表末尾停止"
                  AutomationProperties.Name="连续播放" />
      </Grid>
    </Border>
  </Grid>
  </ContentControl>
</UserControl>
