<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
             x:Class="MySmallTools.Views.SecretVideoPlayer.VideoEncryptorView">
  <UserControl.Styles>
    <StyleInclude Source="avares://MySmallTools/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>

  <Grid Classes="DocumentPage" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="SECVID03 批量视频加密" Classes="PageTitle" />
      <TextBlock Text="严格顺序处理；标题和描述属于公开信息；任何策略都不会覆盖已有文件。"
                 Classes="Caption" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Classes="DocumentToolbar">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
        <Button Grid.Column="0" Content="添加视频" Click="OnBrowseFileClick"
                IsEnabled="{Binding !IsBusy}" Classes="CompactButton accent" />
        <Button Grid.Column="1" Content="移除所选" Command="{Binding RemoveSelectedCommand}"
                Classes="CompactButton" />
        <Button Grid.Column="2" Content="重试所选" Command="{Binding RetrySelectedCommand}"
                Classes="CompactButton" />
        <Button Grid.Column="3" Content="重试全部" Command="{Binding RetryAllCommand}"
                Classes="CompactButton" />
        <Button Grid.Column="4" Content="清空已完成" Command="{Binding ClearCompletedCommand}"
                Classes="CompactButton" />
        <TextBlock Grid.Column="5" VerticalAlignment="Center"
                   Text="{Binding ItemCount, StringFormat='{}{0} 个文件'}" Classes="Caption" />
        <ProgressBar Grid.Column="6" Width="72" Height="3" IsIndeterminate="True"
                     IsVisible="{Binding IsPreflighting}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="DocumentSection">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="8">
        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                  IsChecked="{Binding UseSafeRename}"
                  IsEnabled="{Binding !IsBusy}"
                  Content="冲突时安全添加数字后缀（关闭时严格阻止）" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="公共密码" VerticalAlignment="Center" Classes="Caption" />
        <Grid Grid.Row="1" Grid.Column="1">
          <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="至少 6 个字符"
                   IsVisible="{Binding !ShowPassword}" IsEnabled="{Binding !IsBusy}" />
          <TextBox Text="{Binding Password}" Watermark="至少 6 个字符"
                   IsVisible="{Binding ShowPassword}" IsEnabled="{Binding !IsBusy}" />
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="180,Auto" ColumnSpacing="6">
          <Grid Grid.Column="0">
            <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="再次输入密码"
                     IsVisible="{Binding !ShowPassword}" IsEnabled="{Binding !IsBusy}" />
            <TextBox Text="{Binding ConfirmPassword}" Watermark="再次输入密码"
                     IsVisible="{Binding ShowPassword}" IsEnabled="{Binding !IsBusy}" />
          </Grid>
          <Button Grid.Column="1" Content="显示" Command="{Binding TogglePasswordVisibilityCommand}"
                  IsVisible="{Binding !ShowPassword}" Classes="CompactButton" />
          <Button Grid.Column="1" Content="隐藏" Command="{Binding TogglePasswordVisibilityCommand}"
                  IsVisible="{Binding ShowPassword}" Classes="CompactButton" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="8" MinHeight="220">
      <Grid Grid.Column="0">
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 IsVisible="{Binding HasItems}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                    Margin="5,4" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InputPath}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.StateText}"
                           FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RequestedOutputPath}"
                           Classes="Caption" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding RequestedOutputPath}" />
                <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                             Value="{Binding Status.Progress}" Height="3"
                             IsVisible="{Binding Status.IsRunning}" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Status.Message}"
                           IsVisible="{Binding Status.HasMessage}" Classes="Caption"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status.Message}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !HasItems}" Spacing="4">
          <TextBlock Text="队列为空" HorizontalAlignment="Center" Classes="SectionTitle" />
          <TextBlock Text="一次选择多个普通视频开始批量加密"
                     HorizontalAlignment="Center" Classes="Caption" />
        </StackPanel>
      </Grid>

      <Border Grid.Column="1" Classes="DocumentSection" IsVisible="{Binding HasSelectedItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding SelectedItem}" Spacing="7">
            <TextBlock Text="所选项目" Classes="SectionTitle" />
            <TextBlock Text="输出路径" Classes="Caption" />
            <TextBox Text="{Binding RequestedOutputPath}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsBusy}"
                     ToolTip.Tip="{Binding RequestedOutputPath}" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="公开标题（可留空）" Classes="Caption" />
              <TextBlock Grid.Column="1" Text="{Binding TitleCharacterCount, StringFormat='{}{0} / 200'}"
                         Classes="Caption" />
            </Grid>
            <TextBox Text="{Binding PublicTitle}" IsEnabled="{Binding !$parent[UserControl].DataContext.IsBusy}"
                     Watermark="留空时播放器显示原始文件名" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="公开描述（可留空）" Classes="Caption" />
              <TextBlock Grid.Column="1" Text="{Binding DescriptionCharacterCount, StringFormat='{}{0} / 10000'}"
                         Classes="Caption" />
            </Grid>
            <TextBox Text="{Binding PublicDescription}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="100" MaxHeight="180"
                     IsEnabled="{Binding !$parent[UserControl].DataContext.IsBusy}" />

            <TextBlock Text="{Binding Status.FailureCodeText}"
                       IsVisible="{Binding Status.HasFailureCode}" Classes="Caption" />
            <TextBlock Text="{Binding PreparedOutputPath}"
                       Classes="Caption" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="4" Classes="TaskFooter">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
        <ProgressBar Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding OverallProgress}" Height="5" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="{Binding CurrentFile}" Classes="Caption"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding RunnableCount, StringFormat='可执行 {0}'}" Classes="Caption" />
          <TextBlock Grid.Column="2" Text="{Binding ConflictCount, StringFormat='冲突 {0}'}" Classes="Caption" />
          <TextBlock Grid.Column="3" Text="{Binding WarningCount, StringFormat='警告 {0}'}" Classes="Caption" />
          <TextBlock Grid.Column="4" Text="{Binding BlockingCount, StringFormat='阻止 {0}'}" Classes="Caption" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" />
          <TextBlock Grid.Column="1" Text="{Binding SucceededCount, StringFormat='成功 {0}'}" Classes="Caption" />
          <TextBlock Grid.Column="2" Text="{Binding FailedCount, StringFormat='失败 {0}'}" Classes="Caption" />
          <TextBlock Grid.Column="3" Text="{Binding CancelledCount, StringFormat='取消 {0}'}" Classes="Caption" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
          <SelectableTextBlock Grid.Column="0" Text="{Binding StatusMessage}" Classes="StatusText"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
          <Button Grid.Column="1" Content="取消当前" Command="{Binding CancelCurrentCommand}"
                  Classes="CompactButton" />
          <Button Grid.Column="2" Content="取消全部" Command="{Binding CancelAllCommand}"
                  Classes="CompactButton" />
          <Button Grid.Column="3" Content="检查批次" Command="{Binding CheckBatchCommand}"
                  Classes="CompactButton" />
          <Button Grid.Column="4" Content="开始执行" Command="{Binding StartBatchCommand}"
                  Classes="CompactButton accent" IsDefault="True" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
