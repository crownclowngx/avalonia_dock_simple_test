<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="800"
             x:Class="MySmallTools.Views.SecretVideoPlayer.VideoEncryptorView">
  <UserControl.Styles>
    <StyleInclude Source="avares://MySmallTools/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>

  <Grid Classes="DocumentPage" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="DocumentToolbar">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="SECVID03 视频加密" Classes="PageTitle" />
          <TextBlock Text="按 1 MiB 独立加密；标题和描述为公开信息。"
                     Classes="Caption" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="清空" Command="{Binding ClearAllCommand}"
                Classes="CompactButton" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" Margin="0,2,4,2">
        <Border Classes="DocumentSection">
          <StackPanel Spacing="7">
            <TextBlock Text="文件" Classes="SectionTitle" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Text="源视频" VerticalAlignment="Center" Classes="Caption" />
              <TextBox Grid.Column="1" Text="{Binding SelectedFilePath}" Watermark="选择视频文件..."
                       IsReadOnly="True" ToolTip.Tip="{Binding SelectedFilePath}" />
              <Button Grid.Column="2" Content="浏览" Click="OnBrowseFileClick"
                      IsEnabled="{Binding !IsBusy}" Classes="CompactButton" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
              <TextBlock Grid.Column="0" Text="输出到" VerticalAlignment="Center" Classes="Caption" />
              <TextBox Grid.Column="1" Text="{Binding OutputFilePath}" Watermark="输出 .secvid 路径"
                       IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{Binding OutputFilePath}" />
              <Button Grid.Column="2" Content="自动生成" Command="{Binding GenerateOutputPathCommand}"
                      Classes="CompactButton" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="52,0,0,0">
              <TextBlock Text="{Binding FileSizeText}" Classes="Caption" />
              <TextBlock Text="{Binding FileFormatText}" Classes="Caption" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="DocumentSection">
          <Expander IsExpanded="True" Classes="DocumentSectionExpander">
            <Expander.Header>
              <Grid ColumnDefinitions="*,Auto" MinHeight="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="公开信息" Classes="SectionTitle" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="公开可见" Classes="Caption"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </Expander.Header>
            <StackPanel Spacing="7" Margin="0,8,0,0" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="标题（可留空）" Classes="Caption" />
                <TextBlock Grid.Column="1" Text="{Binding VideoTitleCharacterCount, StringFormat='{}{0} / 200'}"
                           Classes="Caption" />
              </Grid>
              <TextBox Text="{Binding VideoTitle}" Watermark="留空时播放器显示原始文件名"
                       IsEnabled="{Binding !IsBusy}" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                <TextBlock Text="描述（公开可见，可留空）" Classes="Caption" />
                <TextBlock Grid.Column="1" Text="{Binding DescriptionCharacterCount, StringFormat='{}{0} / 10000'}"
                           Classes="Caption" />
              </Grid>
              <TextBox Text="{Binding Description}" Watermark="最多 10,000 个 Unicode 字符"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="180"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </Expander>
        </Border>

        <Border Classes="DocumentSection">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="安全" Classes="SectionTitle" />
              <Button Grid.Column="1" Content="显示密码" Command="{Binding TogglePasswordVisibilityCommand}"
                      IsVisible="{Binding !ShowPassword}" Classes="CompactButton"
                      ToolTip.Tip="显示密码" AutomationProperties.Name="显示两个密码输入框" />
              <Button Grid.Column="1" Content="隐藏密码" Command="{Binding TogglePasswordVisibilityCommand}"
                      IsVisible="{Binding ShowPassword}" Classes="CompactButton"
                      ToolTip.Tip="隐藏密码" AutomationProperties.Name="隐藏两个密码输入框" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Grid Grid.Column="0">
                <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="密码（至少 6 个字符）"
                         IsVisible="{Binding !ShowPassword}" IsEnabled="{Binding !IsBusy}" />
                <TextBox Text="{Binding Password}" Watermark="密码（至少 6 个字符）"
                         IsVisible="{Binding ShowPassword}" IsEnabled="{Binding !IsBusy}" />
              </Grid>
              <Grid Grid.Column="1">
                <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="再次输入密码"
                         IsVisible="{Binding !ShowPassword}" IsEnabled="{Binding !IsBusy}" />
                <TextBox Text="{Binding ConfirmPassword}" Watermark="再次输入密码"
                         IsVisible="{Binding ShowPassword}" IsEnabled="{Binding !IsBusy}" />
              </Grid>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="DocumentSection" IsVisible="{Binding HasPreflightIssues}">
          <StackPanel Spacing="5">
            <TextBlock Text="预检结果" Classes="SectionTitle" />
            <ItemsControl ItemsSource="{Binding PreflightIssues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2" Spacing="1">
                    <TextBlock Text="{Binding SeverityText}" Classes="Caption" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Message}" Classes="StatusText" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SuggestedAction}" Classes="Caption" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="TaskFooter">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
        <ProgressBar Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="5" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding ProgressText}" Classes="StatusText" />
          <TextBlock Grid.Column="1" Text="{Binding ProcessingSpeedText}" HorizontalAlignment="Center"
                     Classes="Caption" />
          <TextBlock Grid.Column="2" Text="{Binding EstimatedTimeText}" Classes="Caption" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
          <SelectableTextBlock Text="{Binding StatusMessage}" Classes="StatusText"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}"
                               VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="取消" Command="{Binding CancelEncryptionCommand}"
                  Classes="CompactButton" MinWidth="76" />
          <Button Grid.Column="2" Content="开始加密" Command="{Binding StartEncryptionCommand}"
                  Classes="CompactButton accent" MinWidth="108" IsDefault="True" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
