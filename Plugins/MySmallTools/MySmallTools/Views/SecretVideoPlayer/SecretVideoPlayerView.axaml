<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoPlayerView">
  <UserControl.Styles>
    <StyleInclude Source="avares://MySmallTools/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>

  <Grid Classes="DocumentPage" RowDefinitions="Auto,Auto,Auto,*">
    <Border Grid.Row="0" Classes="DocumentToolbar">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="文件" VerticalAlignment="Center" Classes="SectionTitle" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FilePath}" IsReadOnly="True"
                 Watermark="选择 .secvid 文件..." ToolTip.Tip="{Binding FilePath}" />
        <Button Grid.Row="0" Grid.Column="2" Content="浏览" Click="OnBrowseFileClick"
                Classes="CompactButton" AutomationProperties.Name="浏览加密视频文件" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="密码" VerticalAlignment="Center" Classes="SectionTitle" />
        <Grid Grid.Row="1" Grid.Column="1">
          <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="输入播放密码"
                   IsVisible="{Binding !ShowPassword}" />
          <TextBox Text="{Binding Password}" Watermark="输入播放密码"
                   IsVisible="{Binding ShowPassword}" />
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="显示" Command="{Binding TogglePasswordVisibilityCommand}"
                  IsVisible="{Binding !ShowPassword}" Classes="CompactButton"
                  ToolTip.Tip="显示密码" AutomationProperties.Name="显示密码" />
          <Button Content="隐藏" Command="{Binding TogglePasswordVisibilityCommand}"
                  IsVisible="{Binding ShowPassword}" Classes="CompactButton"
                  ToolTip.Tip="隐藏密码" AutomationProperties.Name="隐藏密码" />
          <Button Content="加载视频" Command="{Binding LoadVideoCommand}"
                  Classes="CompactButton accent" MinWidth="92" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Padding="2,0" MinHeight="20">
      <TextBlock Text="{Binding StatusMessage}" Classes="StatusText"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
    </Border>

    <Border Grid.Row="2" Classes="DocumentSection">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding PublicTitle}" FontSize="16" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PublicTitle}" />
          <Button Grid.Column="1" Content="编辑信息" Command="{Binding EditPublicInfoCommand}"
                  Classes="CompactButton" />
        </Grid>

        <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasPublicDescription}">
          <SelectableTextBlock Text="{Binding PublicDescription}" TextWrapping="Wrap"
                               FontSize="11" Opacity="0.72" ToolTip.Tip="{Binding PublicDescription}" />
        </ScrollViewer>

        <Border BorderBrush="{DynamicResource DockThemeBorderLowBrush}" BorderThickness="1"
                Padding="10" CornerRadius="5" IsVisible="{Binding IsEditingPublicInfo}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="标题" Classes="SectionTitle" />
              <TextBlock Grid.Column="1" Text="{Binding EditableTitleCharacterCount, StringFormat='{}{0} / 200'}"
                         Classes="Caption" />
            </Grid>
            <TextBox Text="{Binding EditableTitle}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="描述" Classes="SectionTitle" />
              <TextBlock Grid.Column="1" Text="{Binding EditableDescriptionCharacterCount, StringFormat='{}{0} / 10000'}"
                         Classes="Caption" />
            </Grid>
            <TextBox Text="{Binding EditableDescription}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
              <Button Content="取消" Command="{Binding CancelEditPublicInfoCommand}" Classes="CompactButton" />
              <Button Content="保存信息" Command="{Binding SavePublicInfoCommand}"
                      Classes="CompactButton accent" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" MinHeight="180">
      <local:VideoPlayerControl DataContext="{Binding PlayerViewModel}" />
      <Border IsVisible="{Binding IsLoading}" Background="#80000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="正在验证并加载..." FontSize="14" Foreground="White" />
          <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
