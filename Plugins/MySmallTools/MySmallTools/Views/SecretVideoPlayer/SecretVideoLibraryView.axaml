<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             xmlns:converters="clr-namespace:MySmallTools.Converters.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoLibraryView"
             x:Name="LibraryRoot">
  <UserControl.Styles>
    <StyleInclude Source="avares://MySmallTools/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <converters:VideoLibraryEnumDisplayConverter x:Key="LibraryEnumDisplay" />
  </UserControl.Resources>

  <SplitView x:Name="LibrarySplitView"
             IsPaneOpen="{Binding IsLibraryPaneOpen}"
             DisplayMode="CompactInline"
             OpenPaneLength="420"
             CompactPaneLength="40"
             PanePlacement="Left">
    <SplitView.Pane>
      <Grid ColumnDefinitions="40,*">
        <Border Grid.Column="0" Classes="LibraryPaneRail">
          <Grid Margin="0,10">
            <Button Content="‹" Command="{Binding ToggleLibraryPaneCommand}"
                    IsVisible="{Binding IsLibraryPaneOpen}" Classes="IconButton"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    ToolTip.Tip="收起视频列表" AutomationProperties.Name="收起视频列表" />
            <Button Content="›" Command="{Binding ToggleLibraryPaneCommand}"
                    IsVisible="{Binding !IsLibraryPaneOpen}" Classes="IconButton"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    ToolTip.Tip="展开视频列表" AutomationProperties.Name="展开视频列表" />
          </Grid>
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="8"
              Margin="12,10,12,10">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="1">
              <TextBlock Text="媒体库" Classes="PageTitle" FontSize="16" />
              <TextBlock Text="搜索、选择并播放加密视频" Classes="LibraryHint" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding Browser.VisibleItemCount, StringFormat='{}{0} 项'}"
                       VerticalAlignment="Bottom"
                       Classes="LibraryHint" />
          </Grid>

          <Expander Grid.Row="1"
                    IsExpanded="{Binding IsLibrarySettingsExpanded}"
                    Classes="LibrarySettingsExpander"
                    AutomationProperties.Name="库设置">
            <Expander.Header>
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*"
                    ColumnSpacing="8" RowSpacing="2">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="库设置" Classes="SectionTitle" />
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Browser.SortField, Converter={StaticResource LibraryEnumDisplay}}"
                             Classes="LibraryHint" />
                  <TextBlock Text=" · " Classes="LibraryHint" />
                  <TextBlock Text="{Binding Browser.SortDirection, Converter={StaticResource LibraryEnumDisplay}}"
                             Classes="LibraryHint" />
                  <TextBlock Text=" · " Classes="LibraryHint" />
                  <TextBlock Text="{Binding Browser.StatusFilter, Converter={StaticResource LibraryEnumDisplay}}"
                             Classes="LibraryHint" />
                  <TextBlock Text=" · " Classes="LibraryHint" />
                  <TextBlock Text="{Binding PasswordStateText}" Classes="LibraryHint" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding Browser.FolderPath}"
                           IsVisible="{Binding Browser.HasFolder}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Browser.FolderPath}"
                           Classes="LibraryHint" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           Text="尚未选择视频文件夹"
                           IsVisible="{Binding !Browser.HasFolder}"
                           Classes="LibraryHint" />
              </Grid>
            </Expander.Header>

            <!--
              展开设置时限制其最高高度，矮窗口改由设置区内部滚动。这样低频配置不会再次
              把视频列表挤到不可用，同时仍保持原生 Expander 的键盘和自动化语义。
            -->
            <ScrollViewer MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,8,0,0" Spacing="8">
                <Border Classes="LibrarySection">
                  <StackPanel Spacing="6">
                    <TextBlock Text="视频文件夹" Classes="FieldLabel" />
                    <TextBox Text="{Binding Browser.FolderPath}" IsReadOnly="True"
                             Watermark="选择包含 .secvid 的文件夹"
                             ToolTip.Tip="{Binding Browser.FolderPath}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <CheckBox Grid.Column="0" Content="包含子目录"
                                IsChecked="{Binding Browser.IncludeSubdirectories}"
                                VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="选择文件夹" Click="OnBrowseFolderClick"
                              IsEnabled="{Binding !IsOpening}" Classes="CompactButton"
                              AutomationProperties.Name="选择视频文件夹" />
                      <Button Grid.Column="2" Content="刷新" Command="{Binding Browser.RefreshCommand}"
                              IsEnabled="{Binding !IsOpening}" Classes="CompactButton"
                              AutomationProperties.Name="刷新视频列表" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="LibrarySection">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,82,120"
                        ColumnSpacing="6" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="排序字段" Classes="FieldLabel" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="方向" Classes="FieldLabel" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="播放状态" Classes="FieldLabel" />

                    <ComboBox Grid.Row="1" Grid.Column="0"
                              ItemsSource="{Binding Browser.AvailableSortFields}"
                              SelectedItem="{Binding Browser.SortField}"
                              ToolTip.Tip="排序字段">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding Browser.AvailableSortDirections}"
                              SelectedItem="{Binding Browser.SortDirection}"
                              ToolTip.Tip="排序方向">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Row="1" Grid.Column="2"
                              ItemsSource="{Binding Browser.AvailableStatusFilters}"
                              SelectedItem="{Binding Browser.StatusFilter}"
                              ToolTip.Tip="播放状态筛选">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Classes="LibrarySection">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                        ColumnSpacing="6" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="播放密码" Classes="FieldLabel" />
                    <Grid Grid.Row="1" Grid.Column="0">
                      <TextBox Text="{Binding Password}" PasswordChar="●"
                               Watermark="输入当前视频库的公共密码"
                               IsVisible="{Binding !ShowPassword}" />
                      <TextBox Text="{Binding Password}"
                               Watermark="输入当前视频库的公共密码"
                               IsVisible="{Binding ShowPassword}" />
                    </Grid>
                    <Button Grid.Row="1" Grid.Column="1" Content="显示"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            IsVisible="{Binding !ShowPassword}" Classes="CompactButton"
                            ToolTip.Tip="显示密码" AutomationProperties.Name="显示密码" />
                    <Button Grid.Row="1" Grid.Column="1" Content="隐藏"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            IsVisible="{Binding ShowPassword}" Classes="CompactButton"
                            ToolTip.Tip="隐藏密码" AutomationProperties.Name="隐藏密码" />
                  </Grid>
                </Border>

                <Border Classes="LibrarySection">
                  <StackPanel Spacing="5">
                    <TextBlock Text="历史管理" Classes="FieldLabel" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                      <Button Grid.Column="0" Content="清除所选历史"
                              Command="{Binding ClearSelectedHistoryCommand}"
                              Classes="CompactButton" />
                      <Button Grid.Column="1" Content="清空全部历史"
                              Command="{Binding RequestClearAllHistoryCommand}"
                              Classes="CompactButton" />
                    </Grid>
                    <Border IsVisible="{Binding ShowClearHistoryConfirmation}"
                            BorderBrush="DarkOrange" BorderThickness="1"
                            CornerRadius="6" Padding="8">
                      <StackPanel Spacing="5">
                        <TextBlock Text="确定清空全部播放历史？此操作无法撤销。"
                                   Classes="Caption" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                          <Button Grid.Column="0" Content="取消"
                                  Command="{Binding CancelClearAllHistoryCommand}"
                                  Classes="CompactButton" />
                          <Button Grid.Column="1" Content="确认清空"
                                  Command="{Binding ConfirmClearAllHistoryCommand}"
                                  Classes="CompactButton accent" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Expander>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0"
                     Text="{Binding Browser.SearchText}"
                     Watermark="搜索文件名、公开标题或描述"
                     AutomationProperties.Name="搜索媒体库" />
            <Button Grid.Column="1" Content="×"
                    Command="{Binding Browser.ClearSearchCommand}"
                    IsVisible="{Binding Browser.HasSearchText}"
                    Classes="IconButton"
                    ToolTip.Tip="清除搜索"
                    AutomationProperties.Name="清除搜索" />
          </Grid>

          <Border Grid.Row="3" Classes="LibraryListSection">
            <Grid RowDefinitions="Auto,*" RowSpacing="5">
              <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="视频列表" Classes="SectionTitle" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Browser.VisibleItemCount, StringFormat='{}{0} 项'}"
                           VerticalAlignment="Center"
                           Classes="LibraryHint" />
                <TextBlock Grid.Column="2" Text="双击或按 Enter 直接播放"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Classes="LibraryHint" />
              </Grid>

              <Grid Grid.Row="1">
                <ListBox x:Name="VideoList"
                         Classes="LibraryList"
                         ItemsSource="{Binding Browser.VisibleItems}"
                         SelectedItem="{Binding Browser.SelectedItem}"
                         DoubleTapped="OnVideoListDoubleTapped"
                         KeyDown="OnVideoListKeyDown">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding FileNameWithoutExtension}"
                                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding FilePath}" />
                          <TextBlock Grid.Column="1" Text="⚠" IsVisible="{Binding HasError}"
                                     Foreground="DarkOrange" Margin="6,0,0,0"
                                     ToolTip.Tip="{Binding ErrorMessage}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding PublicTitle}"
                                   IsVisible="{Binding HasPublicTitle}" Classes="Caption"
                                   LineHeight="14" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding PublicTitle}" />
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="{Binding HistoryStateText}" Classes="Caption" />
                          <TextBlock Grid.Column="1" Text="{Binding ModifiedTimeText}" Classes="Caption"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding LastPlayedTimeText}" Classes="Caption" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding !Browser.HasFolder}" Spacing="4">
                  <TextBlock Text="尚未选择视频文件夹"
                             HorizontalAlignment="Center" Classes="SectionTitle" />
                  <TextBlock Text="选择文件夹后将在这里显示视频"
                             HorizontalAlignment="Center" Classes="Caption" />
                </StackPanel>
                <Border IsVisible="{Binding Browser.HasFolder}">
                  <Border IsVisible="{Binding !Browser.IsScanning}">
                    <TextBlock Text="没有找到视频，或当前搜索没有匹配项"
                               IsVisible="{Binding !Browser.HasVisibleItems}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Classes="Caption" />
                  </Border>
                </Border>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="4" Classes="TaskFooter" Padding="0,7,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
              <TextBlock Grid.Row="0" Text="{Binding Browser.StatusMessage}" Classes="Caption"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Browser.StatusMessage}" />
              <ProgressBar Grid.Row="1" IsVisible="{Binding Browser.IsScanning}"
                           IsIndeterminate="True" Height="3" />
              <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Classes="StatusText"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
              <Button Grid.Row="3" Content="加载所选视频" Command="{Binding PlaySelectedCommand}"
                      IsEnabled="{Binding PlayerViewModel.IsPlaybackAvailable}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Classes="CompactButton accent" MinHeight="36" IsDefault="True" />
              <TextBlock Grid.Row="4" Text="加载并恢复历史位置，但不会自动播放"
                         HorizontalAlignment="Center" Classes="LibraryHint" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </SplitView.Pane>

    <Border Margin="8">
      <local:VideoPlayerControl DataContext="{Binding PlayerViewModel}"
                                NavigationContext="{Binding #LibraryRoot.DataContext}" />
    </Border>
  </SplitView>
</UserControl>
