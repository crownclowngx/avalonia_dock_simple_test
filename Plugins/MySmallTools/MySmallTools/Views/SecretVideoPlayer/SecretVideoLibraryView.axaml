<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             xmlns:converters="clr-namespace:MySmallTools.Converters.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoLibraryView"
             x:Name="LibraryRoot">
  <UserControl.Styles>
    <StyleInclude Source="avares://MySmallTools/Styles/VideoDocumentStyles.axaml" />
  </UserControl.Styles>
  <UserControl.Resources>
    <converters:VideoLibraryEnumDisplayConverter x:Key="LibraryEnumDisplay" />
  </UserControl.Resources>

  <SplitView IsPaneOpen="{Binding IsLibraryPaneOpen}"
             DisplayMode="CompactInline"
             OpenPaneLength="340"
             CompactPaneLength="32"
             PanePlacement="Left">
    <SplitView.Pane>
      <Grid ColumnDefinitions="32,*">
        <Border Grid.Column="0" BorderBrush="{DynamicResource DockThemeBorderLowBrush}"
                BorderThickness="0,0,1,0">
          <Grid>
            <Button Content="‹" Command="{Binding ToggleLibraryPaneCommand}"
                    IsVisible="{Binding IsLibraryPaneOpen}" Classes="IconButton"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip.Tip="收起视频列表" AutomationProperties.Name="收起视频列表" />
            <Button Content="›" Command="{Binding ToggleLibraryPaneCommand}"
                    IsVisible="{Binding !IsLibraryPaneOpen}" Classes="IconButton"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip.Tip="展开视频列表" AutomationProperties.Name="展开视频列表" />
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6" Margin="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
            <TextBox Grid.Column="0" Text="{Binding Browser.FolderPath}" IsReadOnly="True"
                     Watermark="选择包含 .secvid 的文件夹" ToolTip.Tip="{Binding Browser.FolderPath}" />
            <Button Grid.Column="1" Content="选择" Click="OnBrowseFolderClick"
                    IsEnabled="{Binding !IsOpening}" Classes="CompactButton"
                    AutomationProperties.Name="选择视频文件夹" />
            <Button Grid.Column="2" Content="刷新" Command="{Binding Browser.RefreshCommand}"
                    IsEnabled="{Binding !IsOpening}" Classes="CompactButton"
                    AutomationProperties.Name="刷新视频列表" />
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <TextBox Grid.Column="0" Text="{Binding Browser.SearchText}"
                     Watermark="搜索文件名、标题、描述" />
            <CheckBox Grid.Column="1" Content="递归子目录"
                      IsChecked="{Binding Browser.IncludeSubdirectories}"
                      VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,*,*,116,Auto" ColumnSpacing="4">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Browser.AvailableSortFields}"
                      SelectedItem="{Binding Browser.SortField}"
                      ToolTip.Tip="排序字段">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Browser.AvailableSortDirections}"
                      SelectedItem="{Binding Browser.SortDirection}"
                      ToolTip.Tip="排序方向">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Browser.AvailableStatusFilters}"
                      SelectedItem="{Binding Browser.StatusFilter}"
                      ToolTip.Tip="播放状态筛选">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource LibraryEnumDisplay}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid Grid.Column="3">
              <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="公共密码"
                       IsVisible="{Binding !ShowPassword}" />
              <TextBox Text="{Binding Password}" Watermark="公共密码"
                       IsVisible="{Binding ShowPassword}" />
            </Grid>
            <Button Grid.Column="4" Content="显示" Command="{Binding TogglePasswordVisibilityCommand}"
                    IsVisible="{Binding !ShowPassword}" Classes="CompactButton"
                    ToolTip.Tip="显示密码" AutomationProperties.Name="显示密码" />
            <Button Grid.Column="4" Content="隐藏" Command="{Binding TogglePasswordVisibilityCommand}"
                    IsVisible="{Binding ShowPassword}" Classes="CompactButton"
                    ToolTip.Tip="隐藏密码" AutomationProperties.Name="隐藏密码" />
          </Grid>

          <Grid Grid.Row="3">
            <ListBox x:Name="VideoList"
                     ItemsSource="{Binding Browser.VisibleItems}"
                     SelectedItem="{Binding Browser.SelectedItem}"
                     DoubleTapped="OnVideoListDoubleTapped"
                     KeyDown="OnVideoListKeyDown">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid RowDefinitions="Auto,Auto,Auto" Margin="4,3" RowSpacing="1">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding FileNameWithoutExtension}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
                      <TextBlock Grid.Column="1" Text="⚠" IsVisible="{Binding HasError}"
                                 Foreground="DarkOrange" Margin="5,0,0,0"
                                 ToolTip.Tip="{Binding ErrorMessage}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding PublicTitle}"
                               IsVisible="{Binding HasPublicTitle}" Classes="Caption"
                               LineHeight="14" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding PublicTitle}" />
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <TextBlock Grid.Column="0" Text="{Binding HistoryStateText}" Classes="Caption" />
                      <TextBlock Grid.Column="1" Text="{Binding ModifiedTimeText}" Classes="Caption"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding LastPlayedTimeText}" Classes="Caption" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding !Browser.HasFolder}" Spacing="4">
              <TextBlock Text="尚未选择视频文件夹" HorizontalAlignment="Center" Classes="SectionTitle" />
              <TextBlock Text="选择视频文件夹开始浏览" HorizontalAlignment="Center" Classes="Caption" />
            </StackPanel>
            <Border IsVisible="{Binding Browser.HasFolder}">
              <Border IsVisible="{Binding !Browser.IsScanning}">
                <TextBlock Text="没有找到视频或当前搜索无匹配项"
                           IsVisible="{Binding !Browser.HasVisibleItems}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Caption" />
              </Border>
            </Border>
          </Grid>

          <Border Grid.Row="4" Classes="TaskFooter" Padding="0,7,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
              <TextBlock Grid.Row="0" Text="{Binding Browser.StatusMessage}" Classes="Caption"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Browser.StatusMessage}" />
              <ProgressBar Grid.Row="1" IsVisible="{Binding Browser.IsScanning}"
                           IsIndeterminate="True" Height="3" />
              <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Classes="StatusText"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />
              <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Content="清除所选历史"
                        Command="{Binding ClearSelectedHistoryCommand}"
                        Classes="CompactButton" />
                <Button Grid.Column="1" Content="清空全部历史"
                        Command="{Binding RequestClearAllHistoryCommand}"
                        Classes="CompactButton" />
              </Grid>
              <Border Grid.Row="4" IsVisible="{Binding ShowClearHistoryConfirmation}"
                      BorderBrush="DarkOrange" BorderThickness="1" CornerRadius="4" Padding="6">
                <StackPanel Spacing="4">
                  <TextBlock Text="确定清空全部播放历史？此操作无法撤销。" Classes="Caption" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Grid.Column="0" Content="取消"
                            Command="{Binding CancelClearAllHistoryCommand}"
                            Classes="CompactButton" />
                    <Button Grid.Column="1" Content="确认清空"
                            Command="{Binding ConfirmClearAllHistoryCommand}"
                            Classes="CompactButton accent" />
                  </Grid>
                </StackPanel>
              </Border>
              <Button Grid.Row="5" Content="加载所选视频" Command="{Binding PlaySelectedCommand}"
                      IsEnabled="{Binding PlayerViewModel.IsPlaybackAvailable}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Classes="CompactButton accent" MinHeight="34" IsDefault="True" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </SplitView.Pane>

    <Border Margin="8">
      <local:VideoPlayerControl DataContext="{Binding PlayerViewModel}"
                                NavigationContext="{Binding #LibraryRoot.DataContext}" />
    </Border>
  </SplitView>
</UserControl>
