<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 插件内部的轻量布局样式。颜色和交互状态继续由宿主主题负责。 -->
  <Style Selector="Grid.DocumentPage">
    <Setter Property="Margin" Value="12" />
    <Setter Property="RowSpacing" Value="8" />
  </Style>

  <Style Selector="Border.DocumentToolbar">
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.DocumentSection">
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Expander.DocumentSectionExpander">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.TaskFooter">
    <Setter Property="Padding" Value="10,8,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.68" />
  </Style>

  <Style Selector="TextBlock.StatusText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="SelectableTextBlock.StatusText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="Button.CompactButton">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="Button.IconButton">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!--
    媒体库沿用宿主主题的背景和边框资源，只补充层级、留白与尺寸。
    这里不硬编码卡片底色，否则浅色/深色主题切换时容易出现对比度反转。
  -->
  <Style Selector="Border.LibraryPaneRail">
    <Setter Property="Background" Value="{DynamicResource DockThemeBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.LibrarySection">
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.LibraryListSection">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Expander.LibrarySettingsExpander">
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{DynamicResource DockThemeBorderLowBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="TextBlock.LibraryHint">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Opacity" Value="0.62" />
  </Style>

  <Style Selector="ListBox.LibraryList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.LibraryList ListBoxItem">
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
</Styles>
