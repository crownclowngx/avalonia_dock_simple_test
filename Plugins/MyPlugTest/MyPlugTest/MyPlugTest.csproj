<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- 插件只声明自身发布事实；清单、版本映射和部署由统一协议负责。 -->
        <ManagedPlugin>true</ManagedPlugin>
        <ManagedPluginId>myavalonia.plugin.my-plug-test</ManagedPluginId>
        <ManagedPluginDirectoryName>MyPlugTest</ManagedPluginDirectoryName>
        <PluginVersion>2.0.0</PluginVersion>
        <ManagedPluginRuntimeIdentifier>win-x64</ManagedPluginRuntimeIdentifier>
        <ManagedPluginEntryType>MyPlugTest.Plugin.MyPlugTestPluginModule</ManagedPluginEntryType>
        <ManagedPluginSdkMinInclusive>$(MyAvaloniaPluginSdkVersion)</ManagedPluginSdkMinInclusive>
        <ManagedPluginSdkMaxExclusive>$(MyAvaloniaPluginSdkNextMajorVersion)</ManagedPluginSdkMaxExclusive>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Host\MyAvaloniaManagement.LegacyPluginContracts\MyAvaloniaManagement.LegacyPluginContracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- 插件自身拥有 MVVM 与内部消息 DTO 依赖，基础 SDK 不再传递 Toolkit。 -->
      <PackageReference Include="CommunityToolkit.Mvvm" />
      <PackageReference Include="EPPlus" />
      <PackageReference Include="Flurl.Http" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
      <ManagedPluginPrivatePackage Include="EPPlus;EPPlus.Interfaces;Microsoft.IO.RecyclableMemoryStream;System.Security.Cryptography.Pkcs;System.Security.Cryptography.Xml;Flurl;Flurl.Http" />
    </ItemGroup>

</Project>
