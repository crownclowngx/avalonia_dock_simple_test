<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:sub="using:BiliDownloader.Views.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="BiliDownloader.Views.BiliDownloaderView"
             x:DataType="vm:BiliDownloaderViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://BiliDownloader/Styles/BiliDocumentStyles.axaml" />
    </UserControl.Styles>

    <Design.DataContext>
        <vm:BiliDownloaderViewModel />
    </Design.DataContext>

    <Border Classes="bili-doc-content" ClipToBounds="True">
        <!--
        Document 级滚动是所有展开内容的最终边界；各列表仍可独立滚动。
        设计意图：避免多个 Auto/* 区域在可用高度不足时越界覆盖相邻区域。
        -->
        <ScrollViewer x:Name="DocumentScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsScrollChainingEnabled="True">
            <StackPanel Spacing="10">
                <Border Classes="bili-doc-header">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Bilibili 视频下载器" Classes="bili-doc-title" />
                            <TextBlock Text="解析视频链接，选择内容后提交到后台调度器。"
                                       Classes="bili-doc-caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <sub:LoginBarView Grid.Column="1"
                                          DataContext="{Binding LoginBar}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border IsVisible="{Binding HasCompatibilityWarning}"
                        Padding="12"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource DockThemeBorderLowBrush}"
                        Background="{DynamicResource DockThemeBackgroundBrush}">
                    <TextBlock Text="{Binding CompatibilityWarning}"
                               TextWrapping="Wrap" />
                </Border>

                <sub:DownloadSourceWorkflowView DataContext="{Binding SourceWorkflow}" />
                <sub:DownloadWorkspaceView DataContext="{Binding Workspace}" />
                <sub:DownloadLogView DataContext="{Binding}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
