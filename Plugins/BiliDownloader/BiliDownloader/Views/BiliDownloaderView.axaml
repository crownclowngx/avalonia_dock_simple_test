<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:sub="using:BiliDownloader.Views.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="BiliDownloader.Views.BiliDownloaderView"
             x:DataType="vm:BiliDownloaderViewModel">
    <UserControl.Styles>
        <StyleInclude Source="avares://BiliDownloader/Styles/BiliDocumentStyles.axaml" />
    </UserControl.Styles>

    <Design.DataContext>
        <vm:BiliDownloaderViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Border Classes="bili-doc-content">
            <StackPanel Spacing="10">
                <Border Classes="bili-doc-header">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Bilibili 视频下载器" Classes="bili-doc-title" />
                            <TextBlock Text="解析视频链接，选择内容与质量后提交到后台调度器。"
                                       Classes="bili-doc-caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <sub:LoginBarView Grid.Column="1"
                                          DataContext="{Binding LoginBar}"
                                          VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <sub:VideoParseView DataContext="{Binding VideoParse}" />

                <Border IsVisible="{Binding IsParsed}"
                        Classes="bili-doc-workspace">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <PathIcon Grid.Column="0"
                                      Classes="bili-doc-icon accent"
                                      Data="{StaticResource BiliVideoGeometry}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Classes="bili-doc-section-title"
                                       Text="{Binding VideoParse.VideoCollection.SeriesTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding VideoParse.VideoCollection.SeriesTitle}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <sub:DownloadConfigView DataContext="{Binding DownloadConfig}" />

                        <!-- G5: 命名模板面板（与手动重命名并列共存，模板=自动模式，重命名=覆盖模式） -->
                        <sub:NamingTemplateView DataContext="{Binding NamingTemplate}" />

                        <sub:VideoListView DataContext="{Binding VideoList}" />
                    </StackPanel>
                </Border>

                <Expander x:Name="DownloadLogExpander"
                          Classes="bili-doc-log"
                          IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="bili-doc-icon"
                                      Data="{StaticResource BiliLogGeometry}" />
                            <TextBlock Text="运行日志"
                                       Classes="bili-doc-section-title"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <TextBox Text="{Binding DownloadInfo}"
                             Classes="bili-doc-log-output"
                             Height="150"
                             Margin="0,7,0,0"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             ToolTip.Tip="{Binding DownloadInfo}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
