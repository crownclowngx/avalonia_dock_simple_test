<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:sub="using:BiliDownloader.Views.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BiliDownloader.Views.BiliDownloaderView"
             x:DataType="vm:BiliDownloaderViewModel">
    <Design.DataContext>
        <vm:BiliDownloaderViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="15">

            <!-- 登录状态区域 -->
            <sub:LoginBarView DataContext="{Binding LoginBar}"/>

            <!-- URL 输入 + 解析 -->
            <sub:VideoParseView DataContext="{Binding VideoParse}"/>

            <!-- 解析结果区域 -->
            <Border IsVisible="{Binding IsParsed}"
                    Background="{DynamicResource AppSubtlePanelBrush}"
                    CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                    <!-- 系列标题 -->
                    <TextBlock FontWeight="Bold" FontSize="14"
                               Text="{Binding VideoParse.VideoCollection.SeriesTitle}"/>

                    <!-- 下载配置（清晰度/音频/输出目录） -->
                    <sub:DownloadConfigView DataContext="{Binding DownloadConfig}"/>

                    <!-- 视频列表（含工具栏、重命名面板、提交下载、总进度） -->
                    <sub:VideoListView DataContext="{Binding VideoList}"/>
                </StackPanel>
            </Border>

            <!-- 日志区域 -->
            <TextBlock Text="输出信息：" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBox Text="{Binding DownloadInfo}"
                     Height="160"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
