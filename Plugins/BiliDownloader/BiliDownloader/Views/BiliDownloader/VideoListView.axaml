<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliDownloader"
             xmlns:models="using:BiliDownloader.Models"
             xmlns:conv="using:BiliDownloader.Converters"
             xmlns:sub="using:BiliDownloader.Views.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="440"
             x:Class="BiliDownloader.Views.BiliDownloader.VideoListView"
             x:DataType="vm:VideoListViewModel">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:RenameDisplayConverter x:Key="RenameDisplayConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="视频列表"
                           Classes="bili-doc-section-title"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} 项'}"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectionSummaryText}"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="重命名"
                        Command="{Binding RenamePanel.ToggleRenamePanelCommand}"
                        Classes="bili-doc-button"
                        Margin="0,0,6,4" />
                <Button Content="全选"
                        Command="{Binding SelectAllCommand}"
                        Classes="bili-doc-button"
                        Margin="0,0,6,4" />
                <Button Content="清空"
                        Command="{Binding DeselectAllCommand}"
                        Classes="bili-doc-button"
                        Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>

        <sub:RenamePanelView Grid.Row="1"
                             DataContext="{Binding RenamePanel}" />

        <!-- 显式虚拟化，下载集合较大时只创建可见列表行。 -->
        <ListBox x:Name="VideoItemsList"
                 Grid.Row="2"
                 Classes="bili-doc-list"
                 ItemsSource="{Binding VideoItems}"
                 MinHeight="64"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:BiliVideoItem">
                    <Border BorderBrush="{Binding StageText, Converter={StaticResource StatusToColorConverter}}"
                            BorderThickness="3,0,0,0"
                            Padding="7,5">
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,Auto,*,Auto"
                              RowSpacing="4"
                              ColumnSpacing="6">
                            <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Index, StringFormat='{}{0}.'}"
                                       Classes="bili-doc-caption"
                                       MinWidth="24"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Title}"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource RenameDisplayConverter}">
                                        <Binding Path="OriginalTitle" />
                                        <Binding Path="Title" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <StackPanel Grid.Row="0" Grid.Column="3"
                                        Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding StageText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppInfoBrush}"
                                           MinWidth="48" />
                                <TextBlock Text="{Binding SpeedText}"
                                           Classes="bili-doc-caption"
                                           MinWidth="58" />
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="9">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Duration, StringFormat='时长 {0}'}"
                                           Classes="bili-doc-caption"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Column="1"
                                      ColumnDefinitions="*,*,*"
                                      ColumnSpacing="10">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <TextBlock Text="视频" Classes="bili-doc-caption" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Classes="bili-doc-progress"
                                                     Value="{Binding VideoProgress}"
                                                     Minimum="0" Maximum="100"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <TextBlock Text="音频" Classes="bili-doc-caption" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Classes="bili-doc-progress"
                                                     Value="{Binding AudioProgress}"
                                                     Minimum="0" Maximum="100"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <TextBlock Text="合成" Classes="bili-doc-caption" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1"
                                                     Classes="bili-doc-progress"
                                                     Value="{Binding MergeProgress}"
                                                     Minimum="0" Maximum="100"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                x:Name="DownloadActionBar"
                Classes="bili-doc-flat-section">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="6">
                <ProgressBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Classes="bili-doc-progress"
                             Value="{Binding TotalProgress}"
                             Minimum="0" Maximum="100"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding TotalProgress, StringFormat='总进度 {0:F1}%'}"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding SelectionSummaryText}"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="1"
                        Command="{Binding OpenOutputDirCommand}"
                        Classes="bili-doc-button">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Classes="bili-doc-icon"
                                  Data="{StaticResource BiliFolderGeometry}" />
                        <TextBlock Text="打开输出目录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="2"
                        x:Name="SubmitDownloadButton"
                        Command="{Binding SubmitDownloadCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Classes="bili-doc-button accent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="15" Height="15"
                                  Data="{StaticResource BiliDownloadGeometry}" />
                        <TextBlock Text="{Binding SubmitButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
