<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliDownloader"
             xmlns:views="using:BiliDownloader.Views.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="320"
             x:Class="BiliDownloader.Views.BiliDownloader.DownloadSourceWorkflowView"
             x:DataType="vm:DownloadSourceWorkflowViewModel">
    <StackPanel Spacing="8">
        <Border IsVisible="{Binding HasUnsupportedSource}"
                Padding="12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppPanelBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="不支持的来源类型" FontWeight="SemiBold" />
                <TextBlock Text="当前安装未提供该来源的 Provider。来源身份已原样保留，可查看并另存；不会自动联网。"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding UnsupportedSourceSummary}"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="链接下载" Command="{Binding UseQuickUrlCommand}" Classes="bili-doc-button" />
            <Button Content="个人内容来源" Command="{Binding UsePersonalSourceCommand}" Classes="bili-doc-button" />
        </StackPanel>
        <Grid IsVisible="{Binding IsQuickUrl}">
            <views:VideoParseView DataContext="{Binding QuickUrl}" />
        </Grid>
        <Grid IsVisible="{Binding IsPersonalSource}">
            <Grid IsVisible="{Binding !IsBrowsing}">
                <views:ContentSourcePickerView DataContext="{Binding Picker}" />
            </Grid>
            <Grid IsVisible="{Binding IsBrowsing}">
                <StackPanel Spacing="8">
                    <Button Content="返回来源" Command="{Binding BackToSourcesCommand}"
                            HorizontalAlignment="Left" Classes="bili-doc-button" />
                    <views:ContentSourceBrowserView DataContext="{Binding Browser}" />
                    <!-- 检查更新与普通浏览保持两个明确命令；该面板只生成预览，不直接提交任务。 -->
                    <views:IncrementalComparisonView DataContext="{Binding Comparison}" />
                </StackPanel>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
