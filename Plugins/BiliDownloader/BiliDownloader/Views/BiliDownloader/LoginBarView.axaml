<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="60"
             x:Class="BiliDownloader.Views.BiliDownloader.LoginBarView"
             x:DataType="vm:LoginBarViewModel">
    <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="6" Padding="12">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Grid.Column="0"
                        IsVisible="{Binding IsLoggedIn}">
                <TextBlock Text="已登录：" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="{Binding UserName}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppInfoBrush}"/>
            </StackPanel>
            <Button Content="退出登录"
                    Grid.Column="1"
                    Command="{Binding LogoutCommand}"
                    IsVisible="{Binding IsLoggedIn}"
                    Padding="12,4"/>

            <Button Content="点击登录 Bilibili"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Command="{Binding LoginCommand}"
                    IsVisible="{Binding !IsLoggedIn}"
                    HorizontalAlignment="Left"
                    Padding="16,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,6,0,0"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppWarningBrush}"/>
        </Grid>
    </Border>
</UserControl>
