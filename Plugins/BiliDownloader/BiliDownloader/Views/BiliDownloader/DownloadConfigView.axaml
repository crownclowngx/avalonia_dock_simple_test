<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliDownloader"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="260"
             x:Class="BiliDownloader.Views.BiliDownloader.DownloadConfigView"
             x:DataType="vm:DownloadConfigViewModel">
    <StackPanel Spacing="6">
        <Border Classes="bili-doc-flat-section">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="5">
                <TextBlock Grid.Column="0"
                           Text="下载预设"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Classes="bili-doc-input"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          PlaceholderText="选择预设">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Description}"
                                           Classes="bili-doc-caption"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2"
                        Content="应用"
                        Command="{Binding ApplyPresetCommand}"
                        Classes="bili-doc-button"
                        ToolTip.Tip="将选中预设的配置应用到当前下载" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding PresetStatusText}"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  RowSpacing="5">
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <TextBlock Text="视频质量" Classes="bili-doc-caption" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Classes="bili-doc-input"
                              IsEnabled="{Binding IsVideoOutputEnabled}"
                              ItemsSource="{Binding QualityOptions}"
                              SelectedItem="{Binding SelectedQuality}" />
                </Grid>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <TextBlock Text="音频质量" Classes="bili-doc-caption" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              Classes="bili-doc-input"
                              IsEnabled="{Binding IsAudioOutputEnabled}"
                              ItemsSource="{Binding AudioQualityOptions}"
                              SelectedItem="{Binding SelectedAudioQuality}" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding QualityRestoreNotice}"
                           Classes="bili-doc-caption"
                           Foreground="{DynamicResource AppWarningBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding QualityRestoreNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <StackPanel Spacing="6">
                <TextBlock Text="编码、容器与输出模式" Classes="bili-doc-section-title" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="输出模式" Classes="bili-doc-caption" />
                        <ComboBox Classes="bili-doc-input"
                                  ItemsSource="{Binding OutputMediaModeOptions}"
                                  SelectedItem="{Binding SelectedOutputMediaModeOption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="视频编码" Classes="bili-doc-caption" />
                        <ComboBox Classes="bili-doc-input"
                                  IsEnabled="{Binding IsVideoOutputEnabled}"
                                  ItemsSource="{Binding VideoCodecOptions}"
                                  SelectedItem="{Binding SelectedVideoCodecOption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="输出容器" Classes="bili-doc-caption" />
                        <ComboBox Classes="bili-doc-input"
                                  ItemsSource="{Binding AllowedOutputContainerOptions}"
                                  SelectedItem="{Binding SelectedOutputContainerOption}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding OutputModeHint}"
                           Classes="bili-doc-caption"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <StackPanel Spacing="6">
                <TextBlock Text="高规格媒体" Classes="bili-doc-section-title" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="视频动态范围" Classes="bili-doc-caption" />
                        <ComboBox Classes="bili-doc-input"
                                  IsEnabled="{Binding IsVideoOutputEnabled}"
                                  ItemsSource="{Binding VideoDynamicRangeOptions}"
                                  SelectedItem="{Binding SelectedVideoDynamicRangeOption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="音频规格" Classes="bili-doc-caption" />
                        <ComboBox Classes="bili-doc-input"
                                  IsEnabled="{Binding IsAudioOutputEnabled}"
                                  ItemsSource="{Binding AudioFeatureOptions}"
                                  SelectedItem="{Binding SelectedAudioFeatureOption}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding MediaCapabilityStatusText}"
                           Classes="bili-doc-caption"
                           TextWrapping="Wrap" />
                <TextBlock Text="当前显式高规格在部分所选媒体中不可用；设置会被保留，但提交预检将阻止静默降级。"
                           Classes="bili-doc-caption"
                           Foreground="{DynamicResource AppWarningBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !IsHighSpecificationSelectionValid}" />
            </StackPanel>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                <PathIcon Grid.Column="0"
                          Classes="bili-doc-icon"
                          Data="{StaticResource BiliFolderGeometry}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="输出目录"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="2"
                         Classes="bili-doc-input"
                         Text="{Binding OutputDirectory}"
                         IsReadOnly="True"
                         ToolTip.Tip="{Binding OutputDirectory}" />
                <Button Grid.Column="3"
                        Content="选择文件夹"
                        Command="{Binding SelectFolderCommand}"
                        Classes="bili-doc-button" />
            </Grid>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                <TextBlock Text="文件冲突"
                           Classes="bili-doc-caption"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Classes="bili-doc-input"
                          ItemsSource="{Binding ConflictPolicyOptions}"
                          SelectedItem="{Binding SelectedConflictPolicy}"
                          ToolTip.Tip="提交前会检查主视频、字幕、弹幕、封面和活动任务保留路径" />
            </Grid>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <StackPanel Spacing="5">
                <TextBlock Text="下载内容" Classes="bili-doc-section-title" />
                <WrapPanel>
                    <CheckBox Content="使用分组文件夹"
                              Margin="0,0,14,4"
                              IsChecked="{Binding UseGroupFolder}"
                              IsVisible="{Binding IsMultiVideo}" />
                    <CheckBox Content="标题前添加视频序号"
                              Margin="0,0,14,4"
                              IsChecked="{Binding AddIndexToTitle}"
                              IsVisible="{Binding IsMultiVideo}" />
                    <CheckBox Content="封面图"
                              Margin="0,0,14,4"
                              IsChecked="{Binding DownloadCover}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <StackPanel Spacing="7">
                <DockPanel LastChildFill="True">
                    <CheckBox DockPanel.Dock="Left"
                              Content="字幕"
                              IsChecked="{Binding IsSubtitleEnabled}"
                              Margin="0,0,12,0" />
                    <Button DockPanel.Dock="Right"
                            Content="检测所选项字幕"
                            Command="{Binding DetectSubtitlesCommand}"
                            IsEnabled="{Binding IsSubtitleEnabled}" />
                </DockPanel>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsEnabled="{Binding IsSubtitleEnabled}">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding SubtitleSelectionModeOptions}"
                              SelectedItem="{Binding SelectedSubtitleSelectionModeOption}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SubtitleOutputFormatOptions}"
                              SelectedItem="{Binding SelectedSubtitleOutputFormatOption}" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SubtitleDeliveryModeOptions}"
                              SelectedItem="{Binding SelectedSubtitleDeliveryModeOption}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SubtitleLanguageOptions}"
                              IsVisible="{Binding IsSubtitleEnabled}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayText}"
                                      IsChecked="{Binding IsSelected}"
                                      Margin="0,0,12,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SubtitleDetectionStatusText}"
                           Classes="bili-doc-caption" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SoftSubtitleCompatibilityText}"
                           Classes="bili-doc-caption" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Classes="bili-doc-flat-section">
            <StackPanel Spacing="6">
                <TextBlock Text="弹幕外置格式" Classes="bili-doc-section-title" />
                <WrapPanel>
                    <CheckBox Content="XML（兼容）" IsChecked="{Binding DanmakuXmlEnabled}" Margin="0,0,14,4" />
                    <CheckBox Content="ASS（默认 1920×1080）" IsChecked="{Binding DanmakuAssEnabled}" Margin="0,0,14,4" />
                    <CheckBox Content="JSON" IsChecked="{Binding DanmakuJsonEnabled}" Margin="0,0,14,4" />
                </WrapPanel>
                <TextBlock Text="弹幕不会嵌入视频；ASS 使用内置 Arial 36px、2px 描边确定性样式。"
                           Classes="bili-doc-caption" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
