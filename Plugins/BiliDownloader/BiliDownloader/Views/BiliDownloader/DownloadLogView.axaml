<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="190"
             x:Class="BiliDownloader.Views.BiliDownloader.DownloadLogView"
             x:DataType="vm:BiliDownloaderViewModel">
    <Expander x:Name="DownloadLogExpander"
              Classes="bili-doc-log"
              IsExpanded="False"
              ClipToBounds="True">
        <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Classes="bili-doc-icon" Data="{StaticResource BiliLogGeometry}" />
                <TextBlock Text="运行日志"
                           Classes="bili-doc-section-title"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Expander.Header>
        <TextBox Text="{Binding DownloadInfo}"
                 Classes="bili-doc-log-output"
                 Height="150"
                 Margin="0,7,0,0"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 ToolTip.Tip="{Binding DownloadInfo}"
                 ScrollViewer.IsScrollChainingEnabled="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Expander>
</UserControl>
