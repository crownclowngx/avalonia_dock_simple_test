<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:sub="using:BiliDownloader.Views.BiliScheduler"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="500"
             x:Class="BiliDownloader.Views.BiliSchedulerToolView"
             x:DataType="vm:BiliSchedulerToolViewModel">
    <Design.DataContext>
        <vm:BiliSchedulerToolViewModel />
    </Design.DataContext>
    <DockPanel Margin="10">
        <!-- 顶部：状态区域 -->
        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <Label Content="Bilibili 调度工具" FontSize="14" FontWeight="Bold"/>
            <!-- readiness 是插件内部状态投影；未就绪时整个操作区禁用，并展示脱敏原因。 -->
            <TextBlock Text="{Binding PluginReadinessMessage}"
                       IsVisible="{Binding !IsPluginReady}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding IsPluginReady}">
                <RadioButton Content="活动任务" GroupName="TaskCenterSection"
                             IsChecked="{Binding IsActivitySelected, Mode=OneWay}"
                             Command="{Binding $parent[UserControl].((vm:BiliSchedulerToolViewModel)DataContext).SelectSectionCommand}"
                             CommandParameter="active"/>
                <RadioButton Content="历史" GroupName="TaskCenterSection"
                             IsChecked="{Binding IsHistorySelected, Mode=OneWay}"
                             Command="{Binding $parent[UserControl].((vm:BiliSchedulerToolViewModel)DataContext).SelectSectionCommand}"
                             CommandParameter="history"/>
            </StackPanel>
            <Separator/>

            <!-- 状态摘要 -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto" IsVisible="{Binding IsActivitySelected}"
                  IsEnabled="{Binding IsPluginReady}">
                <TextBlock Grid.Column="0">
                    <Run Text="排队中: " FontWeight="SemiBold"/>
                    <Run Text="{Binding TaskList.PendingCount}"/>
                </TextBlock>
                <TextBlock Grid.Column="1">
                    <Run Text="已完成: " FontWeight="SemiBold"/>
                    <Run Text="{Binding TaskList.CompletedCount}"/>
                </TextBlock>
                <!-- G4: 筛选结果计数 -->
                <TextBlock Grid.Column="2">
                    <Run Text="显示: " FontWeight="SemiBold"/>
                    <Run Text="{Binding TaskList.FilteredCount}"/>
                </TextBlock>
            </Grid>

            <!-- 调度状态 -->
            <TextBlock Text="{Binding SchedulerStatus}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                       Margin="0,4"/>

            <!-- 启动/暂停控制 + 清除已完成 + G2批量控制 -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsActivitySelected}"
                        IsEnabled="{Binding IsPluginReady}">
                <Button Content="开始调度"
                        Command="{Binding TaskList.StartCommand}"
                        IsVisible="{Binding !IsProcessing}"
                        Padding="8,3"
                        FontSize="11"/>
                <Button Content="暂停调度"
                        Command="{Binding TaskList.StopCommand}"
                        IsVisible="{Binding IsProcessing}"
                        Padding="8,3"
                        FontSize="11"/>
                <Button Content="全部暂停"
                        Command="{Binding TaskList.PauseAllCommand}"
                        Padding="8,3"
                        FontSize="11"/>
                <Button Content="全部恢复"
                        Command="{Binding TaskList.ResumeAllCommand}"
                        Padding="8,3"
                        FontSize="11"/>
                <Button Content="清除已完成"
                        Command="{Binding TaskList.ClearDoneCommand}"
                        Padding="8,3"
                        FontSize="11"/>
            </StackPanel>

            <Separator Margin="0,4"/>
        </StackPanel>

        <!-- 底部：设置折叠面板 -->
        <sub:SchedulerSettingsView DockPanel.Dock="Bottom" DataContext="{Binding Settings}"
                                   IsEnabled="{Binding $parent[UserControl].((vm:BiliSchedulerToolViewModel)DataContext).IsPluginReady}"
                                   IsVisible="{Binding $parent[UserControl].((vm:BiliSchedulerToolViewModel)DataContext).IsActivitySelected}"/>

        <!-- 中央：任务列表 -->
        <Grid IsEnabled="{Binding IsPluginReady}">
            <sub:SchedulerTaskListView DataContext="{Binding TaskList}"
                                       IsVisible="{Binding $parent[UserControl].((vm:BiliSchedulerToolViewModel)DataContext).IsActivitySelected}"/>
            <sub:TaskHistoryView DataContext="{Binding History}"
                                 IsVisible="{Binding $parent[UserControl].((vm:BiliSchedulerToolViewModel)DataContext).IsHistorySelected}"/>
        </Grid>
    </DockPanel>
</UserControl>
