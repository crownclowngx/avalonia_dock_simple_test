<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliScheduler"
             xmlns:models="using:BiliDownloader.Models"
             xmlns:conv="using:BiliDownloader.Converters"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="550"
             x:Class="BiliDownloader.Views.BiliScheduler.SchedulerTaskListView"
             x:Name="Root"
             x:DataType="vm:SchedulerTaskListViewModel">
    <UserControl.Styles>
        <Style Selector="UserControl.compact Control.wide-only">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Control.compact-only">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.compact Control.compact-only">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Border.task-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}"/>
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <conv:IsFailedStatusConverter x:Key="IsFailedStatusConverter"/>
        <conv:IsDoneStatusConverter x:Key="IsDoneStatusConverter"/>
        <conv:IsRunningStatusConverter x:Key="IsRunningStatusConverter"/>
        <conv:IsPausedStatusConverter x:Key="IsPausedStatusConverter"/>
        <conv:IsCancelableStatusConverter x:Key="IsCancelableStatusConverter"/>
        <conv:IsRestartableStatusConverter x:Key="IsRestartableStatusConverter"/>
        <conv:ByteSizeConverter x:Key="ByteSizeConverter"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═══════════════════════════════════════════════════════════
             G4: 筛选/排序工具栏（DockPanel.Top）
             设计思考：将筛选控件放在列表顶部，符合用户对"搜索框在列表上方"的直觉。
             使用 WrapPanel 允许窄宽度时自动换行。
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <!-- 标题搜索 -->
            <TextBox Text="{Binding SearchText}"
                     PlaceholderText="搜索标题..."
                     AutomationProperties.Name="搜索下载任务"
                     MinHeight="36"
                     FontSize="11"
                     Padding="6,3"/>

            <!-- 筛选/排序行 -->
            <WrapPanel Orientation="Horizontal">
                <!-- 状态筛选 -->
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatusOption}"
                          FontSize="10"
                          Margin="0,0,4,0"
                          Padding="4,2"
                          ToolTip.Tip="按状态筛选">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Document 筛选 -->
                <ComboBox ItemsSource="{Binding AvailableDocumentOptions}"
                          SelectedValue="{Binding DocumentFilter}"
                          SelectedValueBinding="{Binding Id}"
                          FontSize="10"
                          Margin="0,0,4,0"
                          Padding="4,2"
                          MaxWidth="100"
                          ToolTip.Tip="按下载工作台筛选">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskDocumentFilterOption">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox ItemsSource="{Binding DateOptions}"
                          SelectedItem="{Binding SelectedDateOption}"
                          FontSize="10" Padding="4,2" Margin="0,0,4,0"
                          ToolTip.Tip="按创建时间筛选">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 排序方式 -->
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}"
                          FontSize="10"
                          Padding="4,2"
                          ToolTip.Tip="排序方式">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             G4: 批量操作栏（DockPanel.Bottom）
             设计思考：批量操作放在列表底部，与顶部筛选栏形成"上筛下操"的布局。
             破坏性按钮（删除/重开）仅在有选中项时可见，减少误操作风险。
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0"
                    IsVisible="{Binding HasSelection}">
            <Separator/>
            <!-- 选中统计 -->
            <TextBlock FontSize="10" Foreground="{DynamicResource AppSecondaryTextBrush}">
                <Run Text="已选 "/>
                <Run Text="{Binding SelectedCount}"/>
                <Run Text=" / 显示 "/>
                <Run Text="{Binding FilteredCount}"/>
                <Run Text=" 个"/>
            </TextBlock>

            <!-- 批量操作按钮 -->
            <WrapPanel Orientation="Horizontal">
                <Button Content="全选筛选"
                        Command="{Binding SelectAllFilteredCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"
                        ToolTip.Tip="全选当前筛选结果"/>
                <Button Content="取消选择"
                        Command="{Binding ClearSelectionCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
                <Button Content="批量删除"
                        Command="{Binding BatchDeleteCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"
                        Foreground="{DynamicResource AppErrorBrush}"
                        MinHeight="36"
                        AutomationProperties.Name="批量删除选中任务"
                        ToolTip.Tip="移除选中任务；本地文件是否删除由随后对话框决定"/>
                <Button Content="批量重试"
                        Command="{Binding BatchRetryCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"
                        ToolTip.Tip="重试选中的失败/中断任务"/>
                <Button Content="批量重开"
                        Command="{Binding BatchRestartCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"
                        ToolTip.Tip="重新开始选中任务（清理断点从零下载）"/>
                <Button Content="批量暂停"
                        Command="{Binding BatchPauseCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"
                        ToolTip.Tip="暂停选中的运行中任务"/>
                <Button Content="批量恢复"
                        Command="{Binding BatchResumeCommand}"
                        Padding="6,2" FontSize="10" Margin="0,0,4,2"
                        ToolTip.Tip="恢复选中的暂停/等待登录任务"/>
            </WrapPanel>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             G4: 虚拟化任务列表
             设计思考：将 ItemsControl 替换为 ListBox，
             Avalonia 的 ListBox 默认使用 VirtualizingStackPanel，
             仅实例化可视区域内的容器（约 10 个），100 个任务时不会生成全部视觉树。
             选中状态通过 CheckBox 绑定到模型的 IsSelected 属性（INPC），
             不依赖 ListBox 的 Selection 机制，避免虚拟化回收时选中状态丢失。
        ═══════════════════════════════════════════════════════════ -->
        <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" Width="120"/>
            <TextBlock Text="正在加载任务…" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding ShowEmptyState}">
            <TextBlock Text="还没有下载任务" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="从下载工作台提交内容后，会显示在这里。"
                       Foreground="{DynamicResource AppSecondaryTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding ShowNoResultsState}">
            <TextBlock Text="没有符合条件的任务" FontWeight="SemiBold"/>
            <TextBlock Text="请调整搜索词或筛选条件。" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding HasLoadError}">
            <TextBlock Text="任务加载失败" FontWeight="SemiBold" Foreground="{DynamicResource AppErrorBrush}"/>
            <TextBlock Text="{Binding LoadErrorMessage}" TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox x:Name="TaskList"
                 ItemsSource="{Binding FilteredTasks}"
                 SelectionMode="Multiple"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0">
            <ListBox.Styles>
                <!-- 移除 ListBox 默认选中高亮（选中由 CheckBox 控制） -->
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadTaskItemViewModel">
                    <Border BorderBrush="{DynamicResource AppDividerBrush}"
                            BorderThickness="0,0,0,1" Padding="6,8" Classes="task-row">
                        <DockPanel>
                            <!-- G4: 多选 CheckBox（左侧） -->
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      DockPanel.Dock="Left"
                                      VerticalAlignment="Top"
                                      Margin="0,0,6,0"/>

                            <StackPanel Spacing="3">
                                <!-- 第一行：标题 + 状态 + 操作按钮 -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="{Binding ItemTitle}"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusDisplayText}"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppInfoBrush}"
                                               Margin="4,0"
                                               VerticalAlignment="Center"/>
                                    <!-- G2: 暂停按钮（运行中可见） -->
                                    <Button Content="暂停"
                                            Grid.Column="2"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).PauseTaskCommand}"
                                            CommandParameter="{Binding Record}"
                                            IsVisible="{Binding Status, Converter={StaticResource IsRunningStatusConverter}}"
                                            Padding="4,1" FontSize="10" Margin="2,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="暂停任务"/>
                                    <!-- G2: 恢复按钮（暂停/等待登录可见） -->
                                    <Button Content="恢复"
                                            Grid.Column="3"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).ResumeTaskCommand}"
                                            CommandParameter="{Binding Record}"
                                            IsVisible="{Binding Status, Converter={StaticResource IsPausedStatusConverter}}"
                                            Padding="4,1" FontSize="10" Margin="2,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="恢复任务"/>
                                    <!-- G2: 重新开始按钮（失败/中断/取消可见） -->
                                    <Button Content="重开"
                                            Grid.Column="4"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).RestartTaskCommand}"
                                            CommandParameter="{Binding Record}"
                                            Classes="wide-only"
                                            IsVisible="{Binding Status, Converter={StaticResource IsRestartableStatusConverter}}"
                                            Padding="4,1" FontSize="10" Margin="2,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="重新开始（清理断点从零下载）"/>
                                    <Button Content="重试"
                                            Grid.Column="5"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).RetryTaskCommand}"
                                            CommandParameter="{Binding Record}"
                                            Classes="wide-only"
                                            IsVisible="{Binding Status, Converter={StaticResource IsFailedStatusConverter}}"
                                            Padding="4,1" FontSize="10" Margin="2,0"
                                            VerticalAlignment="Center"/>
                                    <Button Content="打开"
                                            Grid.Column="6"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).OpenFileLocationCommand}"
                                            CommandParameter="{Binding Record}"
                                            Classes="wide-only"
                                            IsVisible="{Binding Status, Converter={StaticResource IsDoneStatusConverter}}"
                                            Padding="4,1" FontSize="10" Margin="2,0"
                                            VerticalAlignment="Center"/>
                                    <Button Content="X"
                                            Grid.Column="7"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).DeleteTaskCommand}"
                                            CommandParameter="{Binding Record}"
                                            Classes="wide-only"
                                            Padding="8,4" FontSize="10"
                                            MinWidth="36" MinHeight="36"
                                            Foreground="{DynamicResource AppErrorBrush}"
                                            AutomationProperties.Name="删除任务"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="删除任务"/>
                                    <Button Content="⋯"
                                            Grid.Column="8"
                                            Classes="compact-only"
                                            MinWidth="36" MinHeight="36"
                                            AutomationProperties.Name="更多任务操作">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="重开"
                                                          Command="{Binding #Root.((vm:SchedulerTaskListViewModel)DataContext).RestartTaskCommand}"
                                                          CommandParameter="{Binding Record}" />
                                                <MenuItem Header="重试"
                                                          Command="{Binding #Root.((vm:SchedulerTaskListViewModel)DataContext).RetryTaskCommand}"
                                                          CommandParameter="{Binding Record}" />
                                                <MenuItem Header="打开位置"
                                                          Command="{Binding #Root.((vm:SchedulerTaskListViewModel)DataContext).OpenFileLocationCommand}"
                                                          CommandParameter="{Binding Record}" />
                                                <MenuItem Header="{Binding PrimaryFailureAction.Label}"
                                                          IsVisible="{Binding HasFailureAction}"
                                                          Command="{Binding #Root.((vm:SchedulerTaskListViewModel)DataContext).ExecuteFailureActionCommand}"
                                                          CommandParameter="{Binding PrimaryFailureActionRequest}" />
                                                <MenuItem Header="{Binding SecondaryFailureAction.Label}"
                                                          IsVisible="{Binding HasSecondaryFailureAction}"
                                                          Command="{Binding #Root.((vm:SchedulerTaskListViewModel)DataContext).ExecuteFailureActionCommand}"
                                                          CommandParameter="{Binding SecondaryFailureActionRequest}" />
                                                <MenuItem Header="删除"
                                                          Command="{Binding #Root.((vm:SchedulerTaskListViewModel)DataContext).DeleteTaskCommand}"
                                                          CommandParameter="{Binding Record}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- 速度文本 -->
                                <TextBlock Text="{Binding SpeedText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppWarningBrush}"
                                           IsVisible="{Binding SpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding EstimatedRemainingText}"
                                           FontSize="10" Foreground="{DynamicResource AppSecondaryTextBrush}"
                                           IsVisible="{Binding EstimatedRemainingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <!-- 三分段进度条 -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Classes="wide-only">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="视频" FontSize="10"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ProgressBar Value="{Binding VideoProgress}"
                                                     Minimum="0" Maximum="100"
                                                     Width="60" Height="3"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="音频" FontSize="10"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ProgressBar Value="{Binding AudioProgress}"
                                                     Minimum="0" Maximum="100"
                                                     Width="60" Height="3"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="合成" FontSize="10"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ProgressBar Value="{Binding MergeProgress}"
                                                     Minimum="0" Maximum="100"
                                                     Width="50" Height="3"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ═══════════════════════════════════════
                                     G4: 扩展信息展示行
                                     展示预计大小、已下载大小、质量、输出路径
                                ═══════════════════════════════════════ -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Classes="wide-only">
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}">
                                        <Run Text="大小: "/>
                                        <Run Text="{Binding TotalDownloadedBytes, Converter={StaticResource ByteSizeConverter}}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding TotalExpectedBytes, Converter={StaticResource ByteSizeConverter}}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10"
                                               Foreground="{DynamicResource AppSecondaryTextBrush}">
                                        <Run Text="质量: "/>
                                        <Run Text="{Binding QualityDisplayText}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 输出路径（截断显示） -->
                                <TextBlock Text="{Binding FullOutputPath}"
                                           Classes="wide-only"
                                           FontSize="10"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding FullOutputPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <!-- 错误信息 -->
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource AppErrorBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <WrapPanel IsVisible="{Binding HasFailureAction}" Orientation="Horizontal">
                                    <Button Content="{Binding PrimaryFailureAction.Label}"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).ExecuteFailureActionCommand}"
                                            CommandParameter="{Binding PrimaryFailureActionRequest}"
                                            Padding="8,3" FontSize="10" Margin="0,3,6,0"/>
                                    <Button Content="{Binding SecondaryFailureAction.Label}"
                                            IsVisible="{Binding HasSecondaryFailureAction}"
                                            Command="{Binding $parent[UserControl].((vm:SchedulerTaskListViewModel)DataContext).ExecuteFailureActionCommand}"
                                            CommandParameter="{Binding SecondaryFailureActionRequest}"
                                            Padding="8,3" FontSize="10" Margin="0,3,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
