<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliScheduler"
             mc:Ignorable="d"
             d:DesignWidth="520" d:DesignHeight="620"
             x:Class="BiliDownloader.Views.BiliScheduler.TaskHistoryView"
             x:Name="Root"
             x:DataType="vm:TaskHistoryViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,6">
            <TextBox Text="{Binding SearchText}"
                     PlaceholderText="搜索历史标题..."
                     AutomationProperties.Name="搜索下载历史"
                     MinHeight="36" Padding="6,3"/>

            <WrapPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValue="{Binding StatusFilter}"
                          SelectedValueBinding="{Binding Value}" MinWidth="105" Margin="0,0,4,4">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding DocumentOptions}" SelectedValue="{Binding DocumentFilter}"
                          SelectedValueBinding="{Binding Id}" MinWidth="105" MaxWidth="160" Margin="0,0,4,4">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TaskDocumentFilterOption"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding DateOptions}" SelectedValue="{Binding DateFilter}"
                          SelectedValueBinding="{Binding Value}" MinWidth="90" Margin="0,0,4,4">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding CodecOptions}" SelectedValue="{Binding CodecFilter}"
                          SelectedValueBinding="{Binding Value}" MinWidth="92" Margin="0,0,4,4">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding ContainerOptions}" SelectedValue="{Binding ContainerFilter}"
                          SelectedValueBinding="{Binding Value}" MinWidth="92" Margin="0,0,4,4">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding OutputModeOptions}" SelectedValue="{Binding OutputModeFilter}"
                          SelectedValueBinding="{Binding Value}" MinWidth="105" Margin="0,0,4,4">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TaskChoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal">
                <Button Content="全选结果" Command="{Binding SelectAllCommand}" Margin="0,0,4,4"/>
                <Button Content="清空选择" Command="{Binding ClearSelectionCommand}" Margin="0,0,4,4"/>
                <Button Content="检查选中" Command="{Binding CheckSelectedCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,4,4"/>
                <Button Content="检查筛选结果" Command="{Binding CheckFilteredCommand}" Margin="0,0,4,4"/>
                <Button Content="取消检查" Command="{Binding CancelCheckCommand}" IsVisible="{Binding IsCheckingFiles}" Margin="0,0,4,4"/>
                <Button Content="导出选中 CSV" Command="{Binding ExportSelectedCsvCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,4,4"/>
                <Button Content="导出选中 JSON" Command="{Binding ExportSelectedJsonCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,4,4"/>
                <Button Content="导出筛选 CSV" Command="{Binding ExportFilteredCsvCommand}" Margin="0,0,4,4"/>
                <Button Content="导出筛选 JSON" Command="{Binding ExportFilteredJsonCommand}" Margin="0,0,4,4"/>
            </WrapPanel>

            <TextBlock Foreground="{DynamicResource AppSecondaryTextBrush}">
                <Run Text="显示 "/><Run Text="{Binding FilteredCount}"/><Run Text=" 项，已选择 "/><Run Text="{Binding SelectedCount}"/><Run Text=" 项"/>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="暂无符合条件的历史记录。"
                   IsVisible="{Binding ShowEmptyState}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>

        <ListBox x:Name="HistoryList" ItemsSource="{Binding Items}"
                 IsVisible="{Binding HasItems}" SelectionMode="Single">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskHistoryItemViewModel">
                    <Border Padding="8" Margin="0,0,0,5" CornerRadius="4"
                            BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <CheckBox Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                      IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                            <DockPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="{Binding StatusDisplayText}" DockPanel.Dock="Right"
                                           FontWeight="SemiBold" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding ItemTitle}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       Text="{Binding SourceDocumentDisplay}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding CreatedAtText}"/><Run Text=" · "/>
                                <Run Text="{Binding QualityText}"/><Run Text=" · "/>
                                <Run Text="{Binding OutputSpecificationText}"/>
                            </TextBlock>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding OutputFilePath}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                <TextBlock Text="{Binding ErrorSummary}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppDangerBrush}"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,5,0,0">
                                <Button Content="检查文件"
                                        Command="{Binding $parent[UserControl].((vm:TaskHistoryViewModel)DataContext).CheckItemCommand}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding FilePresenceText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="定位"
                                        Command="{Binding $parent[UserControl].((vm:TaskHistoryViewModel)DataContext).RevealCommand}"
                                        CommandParameter="{Binding}" IsVisible="{Binding CanReveal}" Margin="0,0,4,0"/>
                                <Button Content="重试原任务"
                                        Command="{Binding $parent[UserControl].((vm:TaskHistoryViewModel)DataContext).RetryOriginalCommand}"
                                        CommandParameter="{Binding}" IsVisible="{Binding CanRetryOriginal}" Margin="0,0,4,0"/>
                                <Button Content="重新下载"
                                        Command="{Binding $parent[UserControl].((vm:TaskHistoryViewModel)DataContext).RedownloadCommand}"
                                        CommandParameter="{Binding}" IsVisible="{Binding CanRedownload}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
