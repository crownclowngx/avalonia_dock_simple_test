<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliScheduler"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="200"
             x:Class="BiliDownloader.Views.BiliScheduler.SchedulerSettingsView"
             x:DataType="vm:SchedulerSettingsViewModel">
    <Expander Header="设置" IsExpanded="False" Margin="0,4,0,0">
        <StackPanel Spacing="8" Margin="0,4,0,0">
            <!-- ffmpeg 设置 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="ffmpeg 设置"/>

                    <TextBlock Text="{Binding FfmpegStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>

                    <TextBlock FontSize="10"
                               Text="{Binding FfmpegPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding FfmpegPath}"/>

                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource AppSecondaryTextBrush}">
                        <Run Text="来源："/><Run Text="{Binding FfmpegSource}"/>
                        <Run Text="　版本："/><Run Text="{Binding FfmpegVersion}"/>
                    </TextBlock>

                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding FfmpegInstallProgress}"
                                 IsVisible="{Binding IsInstallingFfmpeg}"
                                 Height="6"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="安装/修复内置版本"
                                Command="{Binding InstallOrRepairFfmpegCommand}"
                                IsEnabled="{Binding !IsInstallingFfmpeg}"
                                Padding="8,3" FontSize="11"/>
                        <Button Content="重新检测"
                                Command="{Binding RedetectFfmpegCommand}"
                                IsEnabled="{Binding !IsInstallingFfmpeg}"
                                Padding="8,3" FontSize="11"/>
                        <Button Content="选择自定义路径"
                                Command="{Binding BrowseFfmpegCommand}"
                                IsEnabled="{Binding !IsInstallingFfmpeg}"
                                Padding="8,3"
                                FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 默认输出目录 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="默认输出目录"/>
                    <TextBox Text="{Binding DefaultOutputDirectory}"
                             IsReadOnly="True" FontSize="11"/>
                    <Button Content="浏览..."
                            Command="{Binding BrowseOutputDirCommand}"
                            Padding="8,3"
                            FontSize="11"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 并发下载数 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="并发下载数"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding ConcurrentOptions}"
                                  SelectedItem="{Binding MaxConcurrentDownloads}"
                                  Width="80"/>
                        <TextBlock Text="同时下载的任务数量 (1-5)"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 全局限速由应用服务统一持久化并热更新；UI 只使用 KiB/s，避免展示层泄露 B/s 存储细节。 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="5">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="全局主媒体限速"/>
                    <CheckBox Content="启用全局限速"
                              IsChecked="{Binding IsGlobalRateLimitEnabled}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <NumericUpDown Minimum="64" Maximum="104857600"
                                       Increment="64"
                                       Value="{Binding GlobalRateLimitKiBPerSecond}"
                                       IsEnabled="{Binding IsGlobalRateLimitEnabled}"
                                       Width="130"/>
                        <TextBlock Text="KiB/s" VerticalAlignment="Center"/>
                        <Button Content="应用"
                                Command="{Binding ApplyGlobalRateLimitCommand}"
                                Padding="8,3"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BandwidthLimitStatus}"
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Expander>
</UserControl>
