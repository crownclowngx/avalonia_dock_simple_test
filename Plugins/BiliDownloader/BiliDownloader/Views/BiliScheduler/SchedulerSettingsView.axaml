<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels.BiliScheduler"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="200"
             x:Class="BiliDownloader.Views.BiliScheduler.SchedulerSettingsView"
             x:DataType="vm:SchedulerSettingsViewModel">
    <Expander Header="设置" IsExpanded="False" Margin="0,4,0,0">
        <StackPanel Spacing="8" Margin="0,4,0,0">
            <!-- ffmpeg 设置 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="ffmpeg 设置"/>

                    <TextBlock Text="{Binding FfmpegStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource AppSecondaryTextBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="浏览..."
                                Command="{Binding BrowseFfmpegCommand}"
                                Padding="8,3"
                                FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 默认输出目录 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="默认输出目录"/>
                    <TextBox Text="{Binding DefaultOutputDirectory}"
                             IsReadOnly="True" FontSize="11"/>
                    <Button Content="浏览..."
                            Command="{Binding BrowseOutputDirCommand}"
                            Padding="8,3"
                            FontSize="11"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- 并发下载数 -->
            <Border Background="{DynamicResource AppSubtlePanelBrush}" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="并发下载数"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding ConcurrentOptions}"
                                  SelectedItem="{Binding MaxConcurrentDownloads}"
                                  Width="80"/>
                        <TextBlock Text="同时下载的任务数量 (1-5)"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Expander>
</UserControl>
