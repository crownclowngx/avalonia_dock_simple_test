<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- 仅服务下载 Document 的缓存矢量图标。 -->
        <StreamGeometry x:Key="BiliLinkGeometry">M2,5 H10 V7 H4 V13 H10 V15 H2 Z M8,2 H16 V12 H8 V10 H14 V4 H8 Z M6,8 H12 V10 H6 Z</StreamGeometry>
        <StreamGeometry x:Key="BiliAccountGeometry">M9,2 A4,4 0 1 1 9,10 A4,4 0 1 1 9,2 M2,18 C2,13 5,11 9,11 C13,11 16,13 16,18 Z</StreamGeometry>
        <StreamGeometry x:Key="BiliDownloadGeometry">M8,2 H12 V10 H16 L10,16 L4,10 H8 Z M2,18 H18 V20 H2 Z</StreamGeometry>
        <StreamGeometry x:Key="BiliFolderGeometry">M2,4 H8 L10,6 H18 V16 H2 Z M2,7 H18</StreamGeometry>
        <StreamGeometry x:Key="BiliRenameGeometry">M3,15 L4,10 L13,1 L17,5 L8,14 Z M11,3 L15,7 M2,18 H18 V20 H2 Z</StreamGeometry>
        <StreamGeometry x:Key="BiliLogGeometry">M3,2 H17 V4 H3 Z M3,18 H17 V20 H3 Z M3,4 H5 V18 H3 Z M15,4 H17 V18 H15 Z M7,7 H13 V8 H7 Z M7,10 H13 V11 H7 Z M7,13 H11 V14 H7 Z</StreamGeometry>
        <StreamGeometry x:Key="BiliArrowGeometry">M3,9 H15 L11,5 L13,3 L20,10 L13,17 L11,15 L15,11 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="BiliVideoGeometry">M2,3 H18 V5 H2 Z M2,15 H18 V17 H2 Z M2,5 H4 V15 H2 Z M16,5 H18 V15 H16 Z M8,7 L14,10 L8,13 Z</StreamGeometry>
    </Styles.Resources>

    <!-- 所有选择器均使用 bili-doc-* Class，防止样式影响调度 Tool 与登录窗口。 -->
    <Style Selector="Border.bili-doc-content">
        <Setter Property="MaxWidth" Value="1240" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style Selector="Border.bili-doc-header">
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="TextBlock.bili-doc-title">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.bili-doc-section-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.bili-doc-caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>

    <Style Selector="Border.bili-doc-login">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.bili-doc-primary-strip">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.bili-doc-workspace">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Border.bili-doc-flat-section">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.bili-doc-rename-panel">
        <Setter Property="Padding" Value="9" />
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Button.bili-doc-button">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Button.bili-doc-icon-button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="TextBox.bili-doc-input">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBox.bili-doc-input">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="PathIcon.bili-doc-icon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>

    <Style Selector="PathIcon.bili-doc-icon.accent">
        <Setter Property="Foreground" Value="{DynamicResource AppInfoBrush}" />
    </Style>

    <Style Selector="ProgressBar.bili-doc-progress">
        <Setter Property="Height" Value="3" />
    </Style>

    <Style Selector="ListBox.bili-doc-list">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.bili-doc-list ListBoxItem">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="ListBox.bili-doc-list ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
    </Style>

    <Style Selector="ListBox.bili-doc-list ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AppToolSelectedBrush}" />
    </Style>

    <Style Selector="Expander.bili-doc-expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="Expander.bili-doc-log">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="TextBox.bili-doc-log-output">
        <Setter Property="MinHeight" Value="140" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{DynamicResource DockThemeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
</Styles>
