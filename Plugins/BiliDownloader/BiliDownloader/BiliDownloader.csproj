<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
          插件项目只声明自身身份、版本和兼容承诺；程序集元数据、严格清单与部署动作
          由根级 Managed Plugin 构建协议统一派生。
        -->
        <ManagedPlugin>true</ManagedPlugin>
        <ManagedPluginId>myavalonia.plugin.bili-downloader</ManagedPluginId>
        <ManagedPluginDirectoryName>BiliDownloader</ManagedPluginDirectoryName>
        <PluginVersion>2.0.0</PluginVersion>
        <ManagedPluginRuntimeIdentifier>win-x64</ManagedPluginRuntimeIdentifier>
        <ManagedPluginEntryType>BiliDownloader.Plugin.BiliDownloaderPluginModule</ManagedPluginEntryType>
        <ManagedPluginSdkMinInclusive>$(MyAvaloniaPluginSdkVersion)</ManagedPluginSdkMinInclusive>
        <ManagedPluginSdkMaxExclusive>$(MyAvaloniaPluginSdkNextMajorVersion)</ManagedPluginSdkMaxExclusive>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Host\MyAvaloniaManagement.LegacyPluginContracts\MyAvaloniaManagement.LegacyPluginContracts.csproj" />
    </ItemGroup>

  <ItemGroup>
      <!-- 插件自身的 ViewModel 使用 Toolkit；该实现依赖不再由基础 SDK 偶然传递。 -->
      <PackageReference Include="CommunityToolkit.Mvvm" />
      <PackageReference Include="Flurl.Http" />
      <PackageReference Include="Microsoft.Data.Sqlite" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="protobuf-net" />
      <PackageReference Include="QRCoder" />
      <!-- Microsoft.Data.Sqlite 10.0.10 仍允许旧原生包；显式固定安全 bundle，确保 SQLite 原生库一并升级。 -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
      <!-- 仅向测试程序集开放无状态编码帮助类，不扩大插件对宿主的公共契约。 -->
      <InternalsVisibleTo Include="BiliDownloader.Tests" />
  </ItemGroup>

    <ItemGroup>
      <!--
        这里只列插件私有 NuGet 包的资产所有权。公共 Target 根据 NuGetPackageId 收集
        托管与 RID 资产，并把 SQLite 原生文件限制为 Managed Plugin v1 的 win-x64。
      -->
      <ManagedPluginPrivatePackage Include="Flurl;Flurl.Http;Microsoft.Data.Sqlite.Core;protobuf-net;protobuf-net.Core;QRCoder;SQLitePCLRaw.bundle_e_sqlite3;SQLitePCLRaw.core;SQLitePCLRaw.provider.e_sqlite3;SQLitePCLRaw.lib.e_sqlite3" />
    </ItemGroup>

</Project>
