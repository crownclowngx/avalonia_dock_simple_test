<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Host\MyAvaloniaManagementCommon\MyAvaloniaManagementCommon.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Flurl.Http" Version="4.0.2" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
      <PackageReference Include="protobuf-net" Version="3.2.46" />
      <PackageReference Include="QRCoder" Version="1.6.0" />
    </ItemGroup>

    <!-- 构建后将插件及其私有运行时依赖部署到宿主 Controls/BiliDownloader 目录。 -->
    <PropertyGroup>
        <HostProjectOutputDir>$(MSBuildThisFileDirectory)..\..\..\Host\MyAvaloniaManagement\bin\$(Configuration)\$(TargetFramework)</HostProjectOutputDir>
        <PluginDeployDir>$(HostProjectOutputDir)\Controls\BiliDownloader</PluginDeployDir>
    </PropertyGroup>

    <Target Name="DeployPluginToHost"
            AfterTargets="Build"
            DependsOnTargets="ResolveReferences"
            Condition="'$(SkipPluginDeploy)' != 'true'">
        <ItemGroup>
            <!-- 保留当前调试体验；自定义加载上下文运行时只要求插件 DLL 和私有依赖。 -->
            <BiliPluginFiles Include="$(TargetPath)" />
            <BiliPluginFiles Include="$(TargetDir)$(AssemblyName).pdb"
                             Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
            <BiliPluginFiles Include="$(TargetDir)$(AssemblyName).deps.json"
                             Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />

            <!-- 宿主已提供 Avalonia、Dock、DI 和 Common；这里只选择插件自己的 NuGet 运行时依赖。 -->
            <BiliPluginManaged Include="@(RuntimeCopyLocalItems)"
                               Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Flurl' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Flurl.Http' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Data.Sqlite.Core' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'protobuf-net' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'protobuf-net.Core' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'QRCoder' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'SQLitePCLRaw.bundle_e_sqlite3' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'SQLitePCLRaw.core' Or
                                          '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'SQLitePCLRaw.provider.e_sqlite3'" />

            <!-- 保留 SQLitePCLRaw 当前提供的全部 RID，维持既有跨平台部署能力。 -->
            <BiliPluginNative Include="@(RuntimeTargetsCopyLocalItems)"
                              Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'SQLitePCLRaw.lib.e_sqlite3'" />
        </ItemGroup>

        <RemoveDir Directories="$(PluginDeployDir)" />
        <MakeDir Directories="$(PluginDeployDir)" />
        <Copy SourceFiles="@(BiliPluginFiles)"
              DestinationFolder="$(PluginDeployDir)"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(BiliPluginManaged)"
              DestinationFiles="@(BiliPluginManaged->'$(PluginDeployDir)\%(DestinationSubPath)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(BiliPluginNative)"
              DestinationFiles="@(BiliPluginNative->'$(PluginDeployDir)\%(DestinationSubPath)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
