<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[BiliDownloader]*</Include>
          <Exclude>[BiliDownloader.Tests]*</Exclude>
          <!-- XAML、真实 Avalonia 模态/文件选择器和登录窗口计时器属于 TESTING.md 明确的 UI 边界。 -->
          <ExcludeByFile>**/Views/**,**/*.axaml,**/Services/Infrastructure/IConfirmationService.cs,**/Services/Infrastructure/FileRevealService.cs,**/Services/Auth/LoginDialogService.cs,**/ViewModels/Login/LoginWindowViewModel.cs,**/obj/**,**/*.g.cs,**/*.g.i.cs</ExcludeByFile>
          <SkipAutoProps>false</SkipAutoProps>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
