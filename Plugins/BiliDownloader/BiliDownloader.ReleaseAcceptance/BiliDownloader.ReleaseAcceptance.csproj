<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BiliDownloader\BiliDownloader.csproj">
      <AdditionalProperties Condition="'$(BuildingSolutionFile)' != 'true'">SkipPluginDeploy=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 验收程序需要直接读取 SQLite 模式和值；它只扫描沙箱，不接触用户默认数据目录。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- 扫描器和包验证器保持 internal，只向同仓库测试程序集开放。 -->
    <InternalsVisibleTo Include="BiliDownloader.Tests" />
  </ItemGroup>
</Project>
