<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="clr-namespace:MyAvaloniaManagementCommon.Behaviors;assembly=MyAvaloniaManagementCommon"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MySmallTools.Views.SecretVideoPlayer.VideoPlayerControl">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 视频播放区域 -->
        <Border Grid.Row="0" Margin="5" Background="Black">
            <!-- 可靠视频表面会在原生 HWND 创建后显式绑定 MediaPlayer，禁止 LibVLC 回退到独立输出窗口。 -->
            <local:EmbeddedVideoSurface x:Name="VideoSurface" />
        </Border>

        <!-- 状态信息放在普通 Avalonia 布局中，不覆盖原生 HWND，避免 NativeControlHost 的 airspace 限制。 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,2">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding BufferInfo}" FontSize="10" Margin="12,0,0,0"
                       IsVisible="{Binding BufferInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

        <!-- 进度条区域 -->
        <Border Grid.Row="2" Padding="10,5" Margin="5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="12" Margin="0,0,10,0" />

                <Slider x:Name="ProgressSlider" Grid.Column="1" Value="{Binding Position}" Minimum="0" Maximum="100"
                        IsEnabled="True" TickFrequency="1" IsSnapToTickEnabled="False">
                    <i:Interaction.Behaviors>
                        <behaviors:HandledEventsAwareBehavior EventName="PointerPressed"
                                                              Command="{Binding StartSliderDragCommand}"
                                                              HandledEventsToo="True" />
                        <behaviors:HandledEventsAwareBehavior EventName="PointerReleased"
                                                              Command="{Binding EndSliderDragCommand}"
                                                              HandledEventsToo="True" />
                    </i:Interaction.Behaviors>
                </Slider>

                <TextBlock Grid.Column="2" Text="{Binding TotalTime}" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="12" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- 控制按钮区域 -->
        <Border Grid.Row="3" Padding="10" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 播放控制按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Button Content="▶" Command="{Binding PlayCommand}"
                            IsVisible="{Binding !IsPlaying}" MinWidth="40" FontSize="14" />
                    <Button Content="⏸" Command="{Binding PauseCommand}"
                            IsVisible="{Binding IsPlaying}" MinWidth="40" FontSize="14" />
                    <Button Content="⏹" Command="{Binding StopCommand}" MinWidth="40" FontSize="14" />
                </StackPanel>

                <!-- 音量控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="🔊" VerticalAlignment="Center" FontSize="14" />
                    <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="100"
                            TickFrequency="10" IsSnapToTickEnabled="False" />
                    <TextBlock Text="{Binding Volume, StringFormat={}{0:F0}%}" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="12" MinWidth="35" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
