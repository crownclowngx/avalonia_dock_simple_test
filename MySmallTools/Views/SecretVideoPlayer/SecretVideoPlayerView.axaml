<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoPlayerView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 文件选择和密码输入区域 -->
        <Border Grid.Row="0" Background="#000000" Padding="10" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="文件:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" />
                <TextBox Grid.Column="1" Text="{Binding FilePath}" Watermark="选择加密视频文件..." Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="浏览" Click="OnBrowseFileClick" Margin="0,0,10,0" />
                <TextBox Grid.Column="3" Text="{Binding Password}" PasswordChar="*" Watermark="输入密码" Margin="0,0,10,0" />
                <Button Grid.Column="4" Content="加载" Command="{Binding LoadVideoCommand}"
                        IsEnabled="{Binding !IsLoading}" MinWidth="60" />
            </Grid>
        </Border>

        <!-- 播放器控件区域 -->
        <Border Grid.Row="1" Margin="5">
            <Grid>
                <!-- 独立的播放器控件 -->
                <local:VideoPlayerControl x:Name="PlayerControl" 
                                          DataContext="{Binding PlayerViewModel}" />

                <!-- 加载指示器 -->
                <Border IsVisible="{Binding IsLoading}" Background="#80000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在加载..." FontSize="16" HorizontalAlignment="Center" Foreground="White" />
                        <ProgressBar IsIndeterminate="True" Width="200" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 主状态信息覆盖层 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="10" Padding="10,5" CornerRadius="3"
                        Background="#80000000"
                        IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="White" />
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>