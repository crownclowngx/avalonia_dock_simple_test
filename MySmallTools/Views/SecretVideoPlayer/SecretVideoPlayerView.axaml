<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoPlayerView">
  
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <!-- 文件选择和密码输入区域 -->
    <Border Grid.Row="0" Background="#000000" Padding="10" Margin="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" Text="文件:" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Column="1" Text="{Binding FilePath}" Watermark="选择加密视频文件..." Margin="0,0,10,0"/>
        <Button Grid.Column="2" Content="浏览" Click="OnBrowseFileClick" Margin="0,0,10,0"/>
        <TextBox Grid.Column="3" Text="{Binding Password}" PasswordChar="*" Watermark="输入密码" Margin="0,0,10,0"/>
        <Button Grid.Column="4" Content="加载" Command="{Binding LoadVideoCommand}" 
                IsEnabled="{Binding !IsLoading}" MinWidth="60"/>
      </Grid>
    </Border>
    
    <!-- 视频播放区域 -->
    <Border Grid.Row="1"  Margin="5">
      <Grid>
        <!-- LibVLC视频播放控件 -->
        <vlc:VideoView MediaPlayer="{Binding MediaPlayer}" />
        
        <!-- 加载指示器 -->
        <Border IsVisible="{Binding IsLoading}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="正在加载..."  FontSize="16" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        
        <!-- 状态信息 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Left" 
                Margin="10" Padding="10,5" CornerRadius="3"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding StatusMessage}" FontSize="12"/>
        </Border>
        
        <!-- 缓存信息 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" 
                Margin="10" Padding="10,5" CornerRadius="3"
                IsVisible="{Binding BufferInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding BufferInfo}"  FontSize="10"/>
        </Border>
      </Grid>
    </Border>
    
    <!-- 进度条区域 -->
    <Border Grid.Row="2" Padding="10,5" Margin="5,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" VerticalAlignment="Center" 
                   FontFamily="Consolas" FontSize="12" Margin="0,0,10,0"/>
        
        <Slider Grid.Column="1" Value="{Binding Position}" Minimum="0" Maximum="100" 
                IsEnabled="{Binding IsSeekable}" TickFrequency="1" IsSnapToTickEnabled="False"/>
        
        <TextBlock Grid.Column="2" Text="{Binding TotalTime}" VerticalAlignment="Center" 
                   FontFamily="Consolas" FontSize="12" Margin="10,0,0,0"/>
      </Grid>
    </Border>
    
    <!-- 控制按钮区域 -->
    <Border Grid.Row="3" Padding="10" Margin="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- 播放控制按钮 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Button Content="▶" Command="{Binding PlayCommand}" 
                  IsVisible="{Binding !IsPlaying}" MinWidth="40" FontSize="14"/>
          <Button Content="⏸" Command="{Binding PauseCommand}" 
                  IsVisible="{Binding IsPlaying}" MinWidth="40" FontSize="14"/>
          <Button Content="⏹" Command="{Binding StopCommand}" MinWidth="40" FontSize="14"/>
        </StackPanel>
        
        <!-- 音量控制 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <TextBlock Text="🔊" VerticalAlignment="Center" FontSize="14"/>
          <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="100" 
                  TickFrequency="10" IsSnapToTickEnabled="False"/>
          <TextBlock Text="{Binding Volume, StringFormat={}{0:F0}%}" VerticalAlignment="Center" 
                     FontFamily="Consolas" FontSize="12" MinWidth="35"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  
</UserControl>