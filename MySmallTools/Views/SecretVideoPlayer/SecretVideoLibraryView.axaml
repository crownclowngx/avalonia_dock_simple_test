<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoLibraryView">
  <SplitView IsPaneOpen="{Binding IsLibraryPaneOpen}"
             DisplayMode="CompactInline"
             OpenPaneLength="340"
             CompactPaneLength="32"
             PanePlacement="Left">
    <SplitView.Pane>
      <Grid ColumnDefinitions="32,*">
        <Button Grid.Column="0" Content="‹" Command="{Binding ToggleLibraryPaneCommand}"
                IsVisible="{Binding IsLibraryPaneOpen}" Width="28" Height="34"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ToolTip.Tip="收起视频列表" />
        <Button Grid.Column="0" Content="›" Command="{Binding ToggleLibraryPaneCommand}"
                IsVisible="{Binding !IsLibraryPaneOpen}" Width="28" Height="48"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ToolTip.Tip="展开视频列表" />

        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="6" Padding="8" Margin="0,5,5,5">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="6">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
              <TextBox Grid.Column="0" Text="{Binding Browser.FolderPath}" IsReadOnly="True"
                       Watermark="选择包含 .secvid 的文件夹" ToolTip.Tip="{Binding Browser.FolderPath}" />
              <Button Grid.Column="1" Content="选择" Click="OnBrowseFolderClick"
                      IsEnabled="{Binding !IsOpening}" Padding="8,4" />
              <Button Grid.Column="2" Content="刷新" Command="{Binding Browser.RefreshCommand}"
                      IsEnabled="{Binding !IsOpening}" Padding="8,4" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="5">
              <TextBox Grid.Column="0" Text="{Binding Browser.SearchText}"
                       Watermark="搜索文件名、标题、描述" />
              <TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="●"
                       Watermark="公共密码" />
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="1" MinHeight="28">
              <TextBlock Grid.Row="0" Text="{Binding Browser.StatusMessage}" FontSize="10"
                         Foreground="Gray" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Browser.StatusMessage}" />
              <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="10"
                         Foreground="DarkBlue" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding StatusMessage}" />
              <ProgressBar Grid.Row="2" IsVisible="{Binding Browser.IsScanning}"
                           IsIndeterminate="True" Height="2" />
            </Grid>

            <ListBox x:Name="VideoList" Grid.Row="3"
                     ItemsSource="{Binding Browser.VisibleItems}"
                     SelectedItem="{Binding Browser.SelectedItem}"
                     IsEnabled="{Binding !IsOpening}"
                     DoubleTapped="OnVideoListDoubleTapped"
                     KeyDown="OnVideoListKeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid RowDefinitions="Auto,Auto" Margin="3,2" RowSpacing="1">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding FileNameWithoutExtension}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding FilePath}" />
                      <TextBlock Grid.Column="1" Text="⚠" IsVisible="{Binding HasError}"
                                 Foreground="DarkOrange" Margin="5,0,0,0"
                                 ToolTip.Tip="{Binding ErrorMessage}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding PublicTitle}"
                               IsVisible="{Binding HasPublicTitle}"
                               FontSize="11" Foreground="Gray" LineHeight="14"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding PublicTitle}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="4" Content="播放所选视频" Command="{Binding PlaySelectedCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    MinHeight="34" />
          </Grid>
        </Border>
      </Grid>
    </SplitView.Pane>

    <Border Margin="5">
      <local:VideoPlayerControl DataContext="{Binding PlayerViewModel}" />
    </Border>
  </SplitView>
</UserControl>
