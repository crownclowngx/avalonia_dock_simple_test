<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MySmallTools.Views.SecretVideoPlayer"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="MySmallTools.Views.SecretVideoPlayer.SecretVideoLibraryView">
  <Grid ColumnDefinitions="340,5,*" Margin="5">
    <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="12">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Text="视频文件夹" FontSize="18" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Text="{Binding Browser.FolderPath}" IsReadOnly="True"
                     Watermark="选择包含 .secvid 的文件夹" />
            <Button Grid.Column="1" Content="选择" Click="OnBrowseFolderClick"
                    IsEnabled="{Binding !IsOpening}" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="刷新" Command="{Binding Browser.RefreshCommand}"
                    IsEnabled="{Binding !IsOpening}" Margin="6,0,0,0" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="5">
          <TextBlock Text="搜索" FontWeight="SemiBold" />
          <TextBox Text="{Binding Browser.SearchText}"
                   Watermark="搜索文件名、标题或描述" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5">
          <TextBlock Text="公共密码" FontWeight="SemiBold" />
          <TextBox Text="{Binding Password}" PasswordChar="●"
                   Watermark="所有视频使用此密码" />
        </StackPanel>

        <Border Grid.Row="3" Background="#0C000000" CornerRadius="4" Padding="8">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Browser.StatusMessage}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="DarkBlue" />
            <ProgressBar IsVisible="{Binding Browser.IsScanning}" IsIndeterminate="True" Height="3" />
          </StackPanel>
        </Border>

        <ListBox x:Name="VideoList" Grid.Row="4" Margin="0,0,0,2"
                 ItemsSource="{Binding Browser.VisibleItems}"
                 SelectedItem="{Binding Browser.SelectedItem}"
                 IsEnabled="{Binding !IsOpening}"
                 DoubleTapped="OnVideoListDoubleTapped"
                 KeyDown="OnVideoListKeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="3" Spacing="3">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasError}">
                  <TextBlock Text="⚠" Foreground="DarkOrange" />
                  <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkOrange"
                             FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="5" Content="播放所选视频" Command="{Binding PlaySelectedCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                MinHeight="38" />
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                  Background="#22000000" />

    <Border Grid.Column="2" Margin="5,0,0,0">
      <local:VideoPlayerControl DataContext="{Binding PlayerViewModel}" />
    </Border>
  </Grid>
</UserControl>
