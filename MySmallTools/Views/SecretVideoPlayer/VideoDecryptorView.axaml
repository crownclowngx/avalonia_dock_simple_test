<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
             x:Class="MySmallTools.Views.SecretVideoPlayer.VideoDecryptorView">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" Margin="16">
    <StackPanel Grid.Row="0" Spacing="3">
      <TextBlock Text="SECVID03 批量视频解密" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="所选视频共用一个密码；每个文件独立验证，失败不会影响其他文件。"
                 Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="添加视频" Click="OnAddFilesClick" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="1" Content="移除所选" Command="{Binding RemoveSelectedCommand}" />
        <Button Grid.Column="2" Content="清空列表" Command="{Binding ClearCommand}" />
        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                   Text="{Binding ItemCount, StringFormat='{}{0} 个文件'}" Foreground="Gray" />
        <ProgressBar Grid.Column="4" Width="70" Height="4" IsIndeterminate="True"
                     IsVisible="{Binding IsInspecting}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="输出目录" VerticalAlignment="Center" FontWeight="SemiBold" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OutputDirectory}" IsReadOnly="True"
                 Watermark="选择统一输出目录" ToolTip.Tip="{Binding OutputDirectory}" />
        <Button Grid.Row="0" Grid.Column="2" Content="选择目录" Click="OnChooseOutputDirectoryClick"
                IsEnabled="{Binding !IsBusy}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="公共密码" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Grid.Column="1">
          <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="输入所有视频共用的密码"
                   IsVisible="{Binding !ShowPassword}" IsEnabled="{Binding !IsRunning}" />
          <TextBox Text="{Binding Password}" Watermark="输入所有视频共用的密码"
                   IsVisible="{Binding ShowPassword}" IsEnabled="{Binding !IsRunning}" />
        </Grid>
        <Button Grid.Row="1" Grid.Column="2" Content="显示/隐藏"
                Command="{Binding TogglePasswordVisibilityCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="6">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" Margin="4" RowSpacing="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding EncryptedFileName}"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InputPath}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateText}"
                         FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PublicTitle}"
                         IsVisible="{Binding HasPublicTitle}" FontSize="11" Foreground="Gray"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PublicTitle}" />
              <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                           Value="{Binding Progress}" Height="4" Margin="0,3,0,1"
                           IsVisible="{Binding IsRunning}" />
              <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding OutputPath}"
                         IsVisible="{Binding HasOutputPath}" FontSize="10" Foreground="DarkGreen"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputPath}" />
              <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Message}"
                         IsVisible="{Binding HasMessage}" FontSize="10" Foreground="DarkOrange"
                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <ProgressBar Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding OverallProgress}" Height="14" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
          <TextBlock Grid.Column="0" Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding SucceededCount, StringFormat='成功 {0}'}" Foreground="DarkGreen" />
          <TextBlock Grid.Column="2" Text="{Binding FailedCount, StringFormat='失败 {0}'}" Foreground="DarkOrange" />
          <TextBlock Grid.Column="3" Text="{Binding CancelledCount, StringFormat='取消 {0}'}" Foreground="Gray" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <SelectableTextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="DarkBlue" />
          <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" MinWidth="90" />
          <Button Grid.Column="2" Content="开始解密" Command="{Binding StartDecryptionCommand}"
                  MinWidth="120" MinHeight="36" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
