<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="800"
             x:Class="MySmallTools.Views.SecretVideoPlayer.VideoEncryptorView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="14">
      <TextBlock Text="SECVID03 视频加密" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="视频按 1 MiB 独立加密；标题和描述为公开信息，可在输入密码前查看和原地修改。"
                 TextWrapping="Wrap" Foreground="Gray" />

      <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="源视频" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Text="{Binding SelectedFilePath}" Watermark="选择视频文件..." IsReadOnly="True" />
            <Button Grid.Column="1" Content="浏览" Command="{Binding SelectFileCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="清空" Command="{Binding ClearAllCommand}" Margin="8,0,0,0" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="{Binding FileSizeText}" Foreground="Gray" />
            <TextBlock Text="{Binding FileFormatText}" Foreground="Gray" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="标题（可留空）" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding TitleCharacterCount, StringFormat='{}{0} / 200'}" Foreground="Gray" />
          </Grid>
          <TextBox Text="{Binding Title}" Watermark="留空时播放器显示原始文件名" IsEnabled="{Binding !IsEncrypting}" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBlock Text="描述（公开可见，可留空）" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding DescriptionCharacterCount, StringFormat='{}{0} / 10000'}" Foreground="Gray" />
          </Grid>
          <TextBox Text="{Binding Description}" Watermark="最多 10,000 个 Unicode 字符"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="170"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" IsEnabled="{Binding !IsEncrypting}" />
        </StackPanel>
      </Border>

      <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="输出文件" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding OutputFilePath}" Watermark="输出 .secvid 路径" />
            <Button Grid.Column="1" Content="自动生成" Command="{Binding GenerateOutputPathCommand}" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="密码（至少 6 个字符）" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*">
            <TextBox Grid.Column="0" Text="{Binding Password}" PasswordChar="●" Watermark="输入密码" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="再次输入密码" Margin="4,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Button Content="开始加密" Command="{Binding StartEncryptionCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="42" />

      <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="8">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="18" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="{Binding ProgressText}" />
            <TextBlock Grid.Column="1" Text="{Binding ProcessingSpeedText}" HorizontalAlignment="Center" Foreground="Gray" />
            <TextBlock Grid.Column="2" Text="{Binding EstimatedTimeText}" Foreground="Gray" />
          </Grid>
          <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="DarkBlue" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
