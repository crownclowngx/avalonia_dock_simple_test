<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyAvaloniaManagement.ViewModels"
             xmlns:cm="using:MyAvaloniaManagementCommon.DocumentCreation"
             xmlns:generic="using:System.Collections.Generic"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MyAvaloniaManagement.Views.MenuView"
             x:CompileBindings="True" x:DataType="vm:MainWindowViewModel">
    <Menu>
        <MenuItem Header="文件">
            <MenuItem Header="打开" Command="{Binding OpenDocumentCommand}"/>
            <MenuItem Header="保存 (ctrl+s)" Command="{Binding SaveDocumentCommand}"/>
            <Separator/>
        </MenuItem>
    </Menu>
</UserControl>
