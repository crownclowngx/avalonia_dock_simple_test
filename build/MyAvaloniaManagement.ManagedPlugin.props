<Project>
  <PropertyGroup>
    <!--
      插件只维护 PluginVersion。程序集版本、文件版本和信息版本从同一事实派生，
      避免项目、清单和最终 DLL 分别保存版本数字后发生漂移。
    -->
    <Version>$(PluginVersion)</Version>
    <FileVersion>$(PluginVersion).0</FileVersion>
    <InformationalVersion>$(PluginVersion)</InformationalVersion>
    <AssemblyVersion>$(PluginVersion).0</AssemblyVersion>

    <!-- G3 只改变 manifest 与入口协议；当前部署平台仍沿用 Windows x64。 -->
    <ManagedPluginRuntimeIdentifier Condition="'$(ManagedPluginRuntimeIdentifier)' == ''">win-x64</ManagedPluginRuntimeIdentifier>
    <ManagedPluginTargetFramework Condition="'$(ManagedPluginTargetFramework)' == ''">$(TargetFramework)</ManagedPluginTargetFramework>
    <ManagedPluginManifestSchemaVersion Condition="'$(ManagedPluginManifestSchemaVersion)' == '' And '$(MyAvaloniaV2ManifestSchemaVersion)' != ''">$(MyAvaloniaV2ManifestSchemaVersion)</ManagedPluginManifestSchemaVersion>
    <ManagedPluginManifestSchemaVersion Condition="'$(ManagedPluginManifestSchemaVersion)' == ''">2</ManagedPluginManifestSchemaVersion>

    <!--
      普通 Build 默认部署到 Host 输出的 Controls；打包脚本通过全局属性覆盖 DeployRoot，
      从而复用同一文件集合但完全不触碰开发者正在运行的 Host 目录。
    -->
    <!--
      外部插件项目不能猜测 Host 安装位置。仓库根构建入口会显式提供开发部署根；
      NuGet 消费者默认只生成和校验插件输出，只有调用方给出 DeployRoot 时才执行部署。
    -->
    <ManagedPluginDeployDirectory Condition="'$(ManagedPluginDeployRoot)' != ''">$(ManagedPluginDeployRoot)\$(ManagedPluginDirectoryName)</ManagedPluginDeployDirectory>
  </PropertyGroup>
</Project>
