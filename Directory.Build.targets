<Project>
  <!--
    Managed Plugin 只需要在项目文件中声明 ManagedPlugin=true 和自身元数据。
    根级入口统一导入构建协议，避免新插件再次复制一整段部署 Target。
  -->
  <Import Project="$(MSBuildThisFileDirectory)build\MyAvaloniaManagement.ManagedPlugin.props"
          Condition="'$(ManagedPlugin)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)build\MyAvaloniaManagement.ManagedPlugin.targets"
          Condition="'$(ManagedPlugin)' == 'true'" />
</Project>
