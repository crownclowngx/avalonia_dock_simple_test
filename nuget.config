<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="dock-area-fill" value="artifacts/dock-area-fill/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- 补丁 ID 只从本仓构建源解析；其余依赖保持官方源，避免同版本包来源漂移。 -->
  <packageSourceMapping>
    <packageSource key="dock-area-fill"><package pattern="Dock.Avalonia" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
