<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MyAvaloniaManagementCommon\MyAvaloniaManagementCommon.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Flurl.Http" Version="4.0.2" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
      <PackageReference Include="protobuf-net" Version="3.2.46" />
      <PackageReference Include="QRCoder" Version="1.6.0" />
    </ItemGroup>

    <!-- 构建后自动将插件及其第三方依赖部署到主项目的 Controls/BiliDownloader 目录 -->
    <!-- 排除主项目已有的所有 DLL（含 MyAvaloniaManagementCommon 及其传递依赖 Avalonia/Dock 等） -->
    <PropertyGroup>
        <!-- 主项目输出目录 -->
        <HostProjectOutputDir>..\MyAvaloniaManagement\bin\$(Configuration)\$(TargetFramework)</HostProjectOutputDir>
        <!-- 插件部署目标目录 -->
        <PluginDeployDir>$(HostProjectOutputDir)\Controls\BiliDownloader</PluginDeployDir>
        <!-- publish 临时输出目录 -->
        <PluginPublishDir>$(MSBuildThisFileDirectory)obj\publish\$(Configuration)</PluginPublishDir>
        <HostPublishDir>$(MSBuildThisFileDirectory)obj\host-publish\$(Configuration)</HostPublishDir>
        <HostProjectPath>$(MSBuildThisFileDirectory)..\MyAvaloniaManagement\MyAvaloniaManagement.csproj</HostProjectPath>
    </PropertyGroup>

    <Target Name="DeployPluginToHost"
            AfterTargets="Build"
            Condition="'$(SkipPluginDeploy)' != 'true'">
        <!-- 发布插件：获取完整运行时依赖集 -->
        <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -o &quot;$(PluginPublishDir)&quot; --no-build"
              Condition="Exists('$(OutputPath)$(AssemblyName).dll')" />
        <!-- 发布主项目：获取主项目已有的所有 DLL 作为排除基准（不加 nobuild 参数，确保主项目未编译时也能工作） -->
        <Exec Command="dotnet publish &quot;$(HostProjectPath)&quot; -c $(Configuration) -o &quot;$(HostPublishDir)&quot;" />

        <!-- 清理旧的部署文件，然后按文件名做差集仅复制主项目不提供的文件 -->
        <RemoveDir Directories="$(PluginDeployDir)" />
        <MakeDir Directories="$(PluginDeployDir)" />
        <Exec Command="powershell -NoProfile -Command &quot;$base = (Resolve-Path '$(PluginPublishDir)').Path.TrimEnd('\'); $pf = Get-ChildItem -Path $base -Recurse -File; $hf = Get-ChildItem -Path '$(HostPublishDir)' -Recurse -File -ErrorAction SilentlyContinue | ForEach-Object { $_.Name }; $new = $pf | Where-Object { $hf -notcontains $_.Name }; foreach ($f in $new) { $rel = $f.DirectoryName.Substring($base.Length); if ($rel.StartsWith('\')) { $rel = $rel.Substring(1) }; $d = if ($rel) { Join-Path '$(PluginDeployDir)' $rel } else { '$(PluginDeployDir)' }; if (!(Test-Path $d)) { New-Item -ItemType Directory -Path $d -Force | Out-Null }; Copy-Item $f.FullName -Destination $d -Force }; Write-Host ('Deployed ' + $new.Count + ' files to $(PluginDeployDir)')&quot;" />
    </Target>

</Project>
