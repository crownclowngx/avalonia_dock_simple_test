<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="BiliDownloader.Views.BiliSchedulerToolView"
             x:DataType="vm:BiliSchedulerToolViewModel">
    <Design.DataContext>
        <vm:BiliSchedulerToolViewModel />
    </Design.DataContext>
    <StackPanel Spacing="10" Margin="10">
        <Label Content="Bilibili 调度工具" FontSize="14" FontWeight="Bold"/>
        <Separator/>
        <TextBlock Text="调度状态：" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SchedulerStatus}" 
                   TextWrapping="Wrap" 
                   Foreground="Gray"/>
        <Separator/>
        <TextBlock Text="下载任务队列与 ffmpeg 处理进度将在此显示。" 
                   TextWrapping="Wrap"
                   Foreground="DarkGray"
                   FontStyle="Italic"/>
    </StackPanel>
</UserControl>
