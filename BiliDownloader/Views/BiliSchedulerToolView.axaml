<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:models="using:BiliDownloader.Models"
             xmlns:conv="using:BiliDownloader.Converters"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="500"
             x:Class="BiliDownloader.Views.BiliSchedulerToolView"
             x:DataType="vm:BiliSchedulerToolViewModel">
    <Design.DataContext>
        <vm:BiliSchedulerToolViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <conv:IsFailedStatusConverter x:Key="IsFailedStatusConverter"/>
    </UserControl.Resources>
    <DockPanel Margin="10">
        <!-- 头部 -->
        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <Label Content="Bilibili 调度工具" FontSize="14" FontWeight="Bold"/>
            <Separator/>

            <!-- 状态摘要 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0">
                    <Run Text="排队中: " FontWeight="SemiBold"/>
                    <Run Text="{Binding PendingCount}"/>
                </TextBlock>
                <TextBlock Grid.Column="1">
                    <Run Text="已完成: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CompletedCount}"/>
                </TextBlock>
            </Grid>

            <!-- 调度状态 -->
            <TextBlock Text="{Binding SchedulerStatus}"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,4"/>

            <!-- 清除已完成 -->
            <Button Content="清除已完成"
                    Command="{Binding ClearDoneCommand}"
                    HorizontalAlignment="Left"
                    Padding="8,3"
                    FontSize="11"/>

            <Separator Margin="0,4"/>

            <!-- ffmpeg 状态区 -->
            <Border Background="#15FFFFFF" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="ffmpeg 设置"/>

                    <TextBlock Text="{Binding FfmpegStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Gray"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="浏览..."
                                Command="{Binding BrowseFfmpegCommand}"
                                Padding="8,3"
                                FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Margin="0,4"/>
        </StackPanel>

        <!-- 任务列表 -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadTaskRecord">
                        <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="4,6">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Text="{Binding ItemTitle}"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="#00A1D6"
                                               Margin="4,0"
                                               VerticalAlignment="Center"/>
                                    <Button Content="重试"
                                            Grid.Column="2"
                                            Command="{Binding $parent[UserControl].DataContext.RetryTaskCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding Status, Converter={StaticResource IsFailedStatusConverter}}"
                                            Padding="4,1"
                                            FontSize="10"
                                            Margin="2,0"
                                            VerticalAlignment="Center"/>
                                    <Button Content="X"
                                            Grid.Column="3"
                                            Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="4,1"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="删除任务"/>
                                </Grid>

                                <!-- 速度文本 -->
                                <TextBlock Text="{Binding SpeedText}"
                                           FontSize="11"
                                           Foreground="#FFA500"
                                           IsVisible="{Binding SpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <!-- 三分段进度条 -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="视频" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                        <ProgressBar Value="{Binding VideoProgress}"
                                                     Minimum="0" Maximum="100"
                                                     Width="60" Height="3"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="音频" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                        <ProgressBar Value="{Binding AudioProgress}"
                                                     Minimum="0" Maximum="100"
                                                     Width="60" Height="3"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Text="合成" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                        <ProgressBar Value="{Binding MergeProgress}"
                                                     Minimum="0" Maximum="100"
                                                     Width="50" Height="3"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="Red"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
