<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:models="using:BiliDownloader.Models"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="500"
             x:Class="BiliDownloader.Views.BiliSchedulerToolView"
             x:DataType="vm:BiliSchedulerToolViewModel">
    <Design.DataContext>
        <vm:BiliSchedulerToolViewModel />
    </Design.DataContext>
    <DockPanel Margin="10">
        <!-- 头部 -->
        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <Label Content="Bilibili 调度工具" FontSize="14" FontWeight="Bold"/>
            <Separator/>

            <!-- 状态摘要 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                <TextBlock Grid.Column="0">
                    <Run Text="排队中: " FontWeight="SemiBold"/>
                    <Run Text="{Binding PendingCount}"/>
                </TextBlock>
                <TextBlock Grid.Column="1">
                    <Run Text="已完成: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CompletedCount}"/>
                </TextBlock>
            </Grid>

            <!-- 调度状态 -->
            <TextBlock Text="{Binding SchedulerStatus}"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="0,4"/>

            <!-- 清除已完成 -->
            <Button Content="清除已完成"
                    Command="{Binding ClearDoneCommand}"
                    HorizontalAlignment="Left"
                    Padding="8,3"
                    FontSize="11"/>

            <Separator Margin="0,4"/>

            <!-- ffmpeg 状态区 -->
            <Border Background="#15FFFFFF" CornerRadius="4" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" FontSize="12" Text="ffmpeg 设置"/>

                    <TextBlock Text="{Binding FfmpegStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Gray"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="自动下载"
                                Command="{Binding DownloadFfmpegCommand}"
                                IsEnabled="{Binding !FfmpegReady}"
                                Padding="8,3"
                                FontSize="11"/>
                        <Button Content="浏览..."
                                Command="{Binding BrowseFfmpegCommand}"
                                Padding="8,3"
                                FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Separator Margin="0,4"/>
        </StackPanel>

        <!-- 任务列表 -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadTaskRecord">
                        <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="4,6">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ItemTitle}"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Grid.Column="0"/>
                                    <TextBlock Text="{Binding Status}"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="#00A1D6"
                                               Margin="4,0"/>
                                </Grid>

                                <ProgressBar Value="{Binding Progress}"
                                             Minimum="0" Maximum="100"
                                             Height="4"
                                             Margin="0,2"/>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="Red"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
