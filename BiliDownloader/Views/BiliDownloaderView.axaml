<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BiliDownloader.ViewModels"
             xmlns:models="using:BiliDownloader.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BiliDownloader.Views.BiliDownloaderView"
             x:DataType="vm:BiliDownloaderViewModel">
    <Design.DataContext>
        <vm:BiliDownloaderViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Spacing="8" Margin="15">

            <!-- 登录状态区域 -->
            <Border Background="#30FFFFFF" CornerRadius="6" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Grid.Column="0"
                                IsVisible="{Binding IsLoggedIn}">
                        <TextBlock Text="已登录：" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UserName}"
                                   VerticalAlignment="Center"
                                   Foreground="#00A1D6"/>
                    </StackPanel>
                    <Button Content="退出登录"
                            Grid.Column="1"
                            Command="{Binding LogoutCommand}"
                            IsVisible="{Binding IsLoggedIn}"
                            Padding="12,4"/>

                    <Button Content="点击登录 Bilibili"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            Command="{Binding LoginCommand}"
                            IsVisible="{Binding !IsLoggedIn}"
                            HorizontalAlignment="Left"
                            Padding="16,6"/>
                </Grid>
            </Border>

            <Label Content="Bilibili 视频下载器" FontSize="18" FontWeight="Bold"/>

            <!-- URL 输入 + 解析 -->
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <TextBox Text="{Binding Url}"
                         Watermark="请输入链接，例如 https://www.bilibili.com/video/BV1xx411c7mD"
                         Grid.Column="0"
                         VerticalAlignment="Center"/>
                <Button Command="{Binding ParseCommand}"
                        Content="解析"
                        Width="80"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding !IsLoading}"/>
            </Grid>

            <!-- 解析结果区域 -->
            <Border IsVisible="{Binding IsParsed}" Background="#20FFFFFF" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                    <!-- 系列标题 -->
                    <TextBlock FontWeight="Bold" FontSize="14"
                               Text="{Binding VideoCollection.SeriesTitle}"/>

                    <!-- 清晰度选择 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="清晰度：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}"
                                  Width="200"/>
                    </StackPanel>

                    <!-- 音频清晰度选择 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="音频：" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AudioQualityOptions}"
                                  SelectedItem="{Binding SelectedAudioQuality}"
                                  Width="200"/>
                    </StackPanel>

                    <!-- 使用分组文件夹（仅多视频时可见） -->
                    <CheckBox Content="使用分组文件夹（以视频组名称命名）"
                              IsChecked="{Binding UseGroupFolder}"
                              IsVisible="{Binding IsMultiVideo}"/>

                    <!-- 输出目录 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="输出目录：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding OutputDirectory}"
                                 Width="400"
                                 IsReadOnly="True"/>
                        <Button Content="选择文件夹"
                                Command="{Binding SelectFolderCommand}"
                                Padding="8,4"/>
                    </StackPanel>

                    <!-- 视频列表 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Text="视频列表：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="全选" Grid.Column="1" Command="{Binding SelectAllCommand}" Padding="8,2" Margin="4,0"/>
                        <Button Content="全不选" Grid.Column="2" Command="{Binding DeselectAllCommand}" Padding="8,2"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding VideoItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BiliVideoItem">
                                <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="4,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <!-- 行1: 勾选 + 标题 + 时长 + 阶段 + 速度 -->
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Grid.Column="0"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="4,0"/>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="Gray"
                                                   Margin="4,0">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Duration"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StageText}"
                                                   Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   Foreground="#00A1D6"
                                                   Margin="4,0"
                                                   MinWidth="50"/>
                                        <TextBlock Text="{Binding SpeedText}"
                                                   Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFA500"
                                                   Margin="4,0"
                                                   MinWidth="60"/>

                                        <!-- 行2: 三分段进度条 -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1"
                                                    Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="视频" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                                <ProgressBar Value="{Binding VideoProgress}"
                                                             Minimum="0" Maximum="100"
                                                             Width="100" Height="4"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="音频" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                                <ProgressBar Value="{Binding AudioProgress}"
                                                             Minimum="0" Maximum="100"
                                                             Width="100" Height="4"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="合成" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                                <ProgressBar Value="{Binding MergeProgress}"
                                                             Minimum="0" Maximum="100"
                                                             Width="80" Height="4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 提交下载 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding SubmitDownloadCommand}"
                                Content="提交下载"
                                Width="120"
                                Padding="8,6"/>
                        <TextBlock Text="{Binding TotalProgress, StringFormat='总进度: {0:F1}%'}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 总进度条 -->
            <ProgressBar Value="{Binding TotalProgress}"
                         Minimum="0" Maximum="100"
                         Height="8"
                         IsVisible="{Binding IsParsed}"/>

            <!-- 日志区域 -->
            <TextBlock Text="输出信息：" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBox Text="{Binding DownloadInfo}"
                     Height="120"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
